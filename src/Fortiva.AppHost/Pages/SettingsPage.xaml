<Page
    x:Class="Fortiva.AppHost.Pages.SettingsPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer x:Name="PageScroll"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <Border Style="{StaticResource FortivaGlassPanel}" Margin="24"
                HorizontalAlignment="Stretch" MinWidth="320"
                Width="{Binding ViewportWidth, ElementName=PageScroll}">
        <StackPanel Spacing="24">
            <TextBlock Text="Settings" Style="{StaticResource FortivaPageTitle}"/>

            <!-- Appearance -->
            <StackPanel Spacing="12">
                <TextBlock Text="Appearance" Style="{StaticResource FortivaSectionTitle}"/>
                <ComboBox x:Name="ThemeCombo" Header="Theme" Style="{StaticResource FortivaComboBox}" SelectionChanged="Theme_Changed">
                    <ComboBoxItem Content="Use system setting" Tag="System"/>
                    <ComboBoxItem Content="Light" Tag="Light"/>
                    <ComboBoxItem Content="Dark" Tag="Dark"/>
                </ComboBox>
            </StackPanel>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- Security -->
            <StackPanel Spacing="16">
                <TextBlock Text="Security" Style="{StaticResource FortivaSectionTitle}"/>

                <ToggleSwitch x:Name="ParanoiaModeSwitch" Style="{StaticResource FortivaToggleSwitch}"
                              Header="Paranoia Mode"
                              OffContent="Off - vault opens with rollback warning"
                              OnContent="On - vault opens read-only if rollback detected"
                              Toggled="ParanoiaMode_Toggled"/>

                <StackPanel Spacing="4">
                    <TextBlock Text="Auto-lock after inactivity" Style="{StaticResource FortivaFieldLabel}"/>
                    <Slider x:Name="AutoLockSlider" ValueChanged="AutoLock_Changed"/>
                    <TextBlock x:Name="AutoLockLabel" Style="{StaticResource FortivaHelperText}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Clipboard auto-clear" Style="{StaticResource FortivaFieldLabel}"/>
                    <Slider x:Name="ClipboardSlider" ValueChanged="Clipboard_Changed"/>
                    <TextBlock x:Name="ClipboardLabel" Style="{StaticResource FortivaHelperText}"/>
                </StackPanel>
            </StackPanel>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- Windows Hello -->
            <StackPanel Spacing="12">
                <TextBlock Text="Windows Hello" Style="{StaticResource FortivaSectionTitle}"/>
                <TextBlock TextWrapping="WrapWholeWords" Style="{StaticResource FortivaBodyText}" FontSize="13">
                    Windows Hello protects access to the vault key protector.
                    When configured, you can unlock with face recognition, fingerprint, or PIN.
                </TextBlock>
                <TextBlock x:Name="HelloStatus" Style="{StaticResource FortivaBodyText}" FontSize="13"/>
                <InfoBar x:Name="HelloUpgradeInfo"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Informational"
                         Title="Upgrade Windows Hello security"
                         Message="Your Hello credential uses software protection. Re-enroll once to use hardware-backed TPM storage when available."
                         Closed="HelloUpgradeInfo_Closed"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SetupHelloBtn" Content="Set up Windows Hello" Click="SetupHello_Click"/>
                    <Button x:Name="RemoveHelloBtn" Content="Remove Hello credential" Click="RemoveHello_Click"/>
                </StackPanel>
            </StackPanel>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- Browser extension -->
            <StackPanel x:Name="BrowserExtensionSection" Spacing="12">
                <TextBlock Text="Browser extension" Style="{StaticResource FortivaSectionTitle}"/>
                <TextBlock TextWrapping="WrapWholeWords" Style="{StaticResource FortivaBodyText}" FontSize="13">
                    On any login page, click the Fortiva icon in Edge or Chrome and choose Fill login.
                    Fortiva prepares the connection for you — one quick browser step the first time.
                </TextBlock>
                <Border Style="{StaticResource FortivaGlassPanelGlow}" Padding="14">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="BrowserExtensionStatusText" Style="{StaticResource FortivaBodyText}" FontSize="13"/>
                        <TextBlock x:Name="BrowserExtensionPathText" Style="{StaticResource FortivaHelperText}"
                                   FontFamily="Consolas"/>
                    </StackPanel>
                </Border>
                <Button x:Name="ConnectBrowserBtn" Content="Connect browser"
                        HorizontalAlignment="Left"
                        Style="{StaticResource FortivaAccentButton}" Click="ConnectBrowser_Click"/>
                <TextBlock TextWrapping="WrapWholeWords" Style="{StaticResource FortivaHelperText}">
                    Fortiva never fills a form unless you click Fill. Keep the app unlocked while browsing.
                </TextBlock>
            </StackPanel>

            <Border x:Name="BrowserExtensionDivider" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- Change master password -->
            <StackPanel Spacing="12">
                <TextBlock Text="Change master password" Style="{StaticResource FortivaSectionTitle}"/>
                <StackPanel Spacing="8">
                    <PasswordBox x:Name="CurrentPwd" Style="{StaticResource FortivaPasswordBox}" PlaceholderText="Current master password"/>
                    <PasswordBox x:Name="NewPwd" Style="{StaticResource FortivaPasswordBox}" PlaceholderText="New master password" PasswordChanged="NewPwd_Changed"/>
                    <PasswordBox x:Name="NewPwdConfirm" Style="{StaticResource FortivaPasswordBox}" PlaceholderText="Confirm new password"/>
                    <ProgressBar x:Name="NewPwdStrength" Maximum="4" Height="4"/>
                    <TextBlock x:Name="NewPwdStrengthLabel" Style="{StaticResource FortivaHelperText}"/>
                    <Button x:Name="ChangePasswordBtn" Content="Change password" Click="ChangePassword_Click"/>
                </StackPanel>
            </StackPanel>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- Updates (Personal) -->
            <StackPanel x:Name="UpdatesSection" Spacing="12">
                <TextBlock Text="Updates" Style="{StaticResource FortivaSectionTitle}"/>
                <TextBlock TextWrapping="WrapWholeWords" Style="{StaticResource FortivaBodyText}" FontSize="13">
                    Fortiva checks GitHub Releases for verified updates. Routine Windows security patches do not require a new Fortiva install.
                </TextBlock>
                <TextBlock x:Name="UpdateFeedText" Style="{StaticResource FortivaHelperText}"/>
                <ToggleSwitch x:Name="AutoUpdateSwitch" Style="{StaticResource FortivaToggleSwitch}"
                              Header="Automatic updates"
                              OffContent="Off - check manually only"
                              OnContent="On - verify and install in the background"
                              Toggled="AutoUpdate_Toggled"/>
                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource FortivaMutedText}"/>
                <InfoBar x:Name="UpdateApplyFailureInfo"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Warning"
                         Title="Automatic update failed"
                         Closed="UpdateApplyFailureInfo_Closed"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CheckUpdateBtn" Content="Check for updates"
                            Style="{StaticResource FortivaAccentButton}" Click="CheckUpdate_Click"/>
                    <ProgressRing x:Name="UpdateBusyRing" IsActive="False" Width="20" Height="20"/>
                </StackPanel>
            </StackPanel>

            <Border x:Name="UpdatesDivider" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <Border x:Name="PortableSectionDivider" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- Enterprise shared vault -->
            <StackPanel x:Name="SharedVaultSection" Spacing="12" Visibility="Collapsed">
                <TextBlock Text="Shared vault" Style="{StaticResource FortivaSectionTitle}"/>
                <TextBlock TextWrapping="WrapWholeWords" Style="{StaticResource FortivaBodyText}" FontSize="13">
                    Select an organization shared vault configured by IT, or use the default vault on this PC.
                </TextBlock>
                <ComboBox x:Name="SharedVaultBox" Header="Active vault" Style="{StaticResource FortivaComboBox}" SelectionChanged="SharedVault_Changed"/>
                <TextBlock x:Name="SharedVaultStatusText" Style="{StaticResource FortivaMutedText}"/>
            </StackPanel>

            <Border x:Name="SharedVaultSectionDivider" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Visibility="Collapsed"/>

            <!-- Portable mode -->
            <StackPanel x:Name="PortableSection" Spacing="12">
                <TextBlock Text="Portable mode" Style="{StaticResource FortivaSectionTitle}"/>
                <TextBlock TextWrapping="WrapWholeWords" Style="{StaticResource FortivaBodyText}" FontSize="13">
                    Store and run your vault from a USB drive. Fortiva remembers your USB location
                    and reopens it automatically when the drive is connected.
                    Note: Windows may leave traces (prefetch, MRU) on the host PC.
                </TextBlock>
                <TextBlock x:Name="PortableStatusText" Style="{StaticResource FortivaMutedText}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PortableBtn" Content="Open or create vault on USB…" Click="Portable_Click"/>
                    <Button x:Name="LocalVaultBtn" Content="Use local vault" Click="LocalVault_Click" Visibility="Collapsed"/>
                </StackPanel>
                <TextBlock TextWrapping="WrapWholeWords" Style="{StaticResource FortivaBodyText}" FontSize="13">
                    Sync merges entries both ways between your active vault and its counterpart
                    (local ⇄ USB). The newest edit of each entry wins, and deletions are propagated.
                    A snapshot of each vault is kept so you can roll back.
                </TextBlock>
                <Button x:Name="SyncBtn" Content="Sync with counterpart vault…" Click="Sync_Click"/>
            </StackPanel>

            <!-- Vault info -->
            <Border Style="{StaticResource FortivaGlassPanelGlow}" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Vault information" Style="{StaticResource FortivaFieldLabel}"/>
                    <TextBlock x:Name="VaultInfoText" Style="{StaticResource FortivaMutedText}"
                               FontFamily="Consolas"/>
                </StackPanel>
            </Border>

            <InfoBar x:Name="SettingsInfo" IsOpen="False" IsClosable="True"/>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- About -->
            <StackPanel Spacing="6">
                <TextBlock Text="About" Style="{StaticResource FortivaSectionTitle}"/>
                <Border CornerRadius="8" Padding="16"
                        Background="{ThemeResource FortivaAccentGlowBrush}"
                        BorderBrush="{ThemeResource FortivaGlassBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Image x:Name="AboutLogo" Width="72" Height="72"
                               HorizontalAlignment="Left" Stretch="Uniform"/>
                        <TextBlock x:Name="AboutAppName" Style="{StaticResource FortivaFieldLabel}" FontSize="14"/>
                        <TextBlock x:Name="AboutVersion" Style="{StaticResource FortivaMutedText}"/>
                        <TextBlock x:Name="AboutPublisher" Style="{StaticResource FortivaHelperText}"/>
                        <TextBlock Style="{StaticResource FortivaHelperText}" Margin="0,4,0,0"
                                   Text="Zero-knowledge. Local-first. Windows-native."/>
                        <HyperlinkButton x:Name="WebsiteLink" Content="fortiva.studio.icmclab.cloud"
                                         Style="{StaticResource FortivaHyperlink}" Margin="0,2,0,0" Click="WebsiteLink_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
