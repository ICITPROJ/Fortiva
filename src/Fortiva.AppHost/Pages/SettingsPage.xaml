<Page
    x:Class="Fortiva.AppHost.Pages.SettingsPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <Border Style="{StaticResource FortivaGlassPanel}" Margin="24" MaxWidth="560" HorizontalAlignment="Left">
        <StackPanel Spacing="24">
            <TextBlock Text="Settings" Style="{StaticResource FortivaPageTitle}"/>

            <!-- Appearance -->
            <StackPanel Spacing="12">
                <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" Opacity="0.7"/>
                <ComboBox x:Name="ThemeCombo" Header="Theme" SelectionChanged="Theme_Changed">
                    <ComboBoxItem Content="Use system setting" Tag="System"/>
                    <ComboBoxItem Content="Light" Tag="Light"/>
                    <ComboBoxItem Content="Dark" Tag="Dark"/>
                </ComboBox>
            </StackPanel>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- Security -->
            <StackPanel Spacing="16">
                <TextBlock Text="Security" FontSize="16" FontWeight="SemiBold" Opacity="0.7"/>

                <ToggleSwitch x:Name="ParanoiaModeSwitch" Header="Paranoia Mode"
                              OffContent="Off — vault opens with rollback warning"
                              OnContent="On — vault opens read-only if rollback detected"
                              Toggled="ParanoiaMode_Toggled"/>

                <StackPanel Spacing="4">
                    <TextBlock Text="Auto-lock after inactivity" FontWeight="SemiBold" FontSize="13"/>
                    <!-- Minimum/Maximum/Value set in code-behind — WinUI 3 XBF replays attributes
                         in source order; setting Minimum before Value violates the range constraint -->
                    <Slider x:Name="AutoLockSlider" ValueChanged="AutoLock_Changed"/>
                    <TextBlock x:Name="AutoLockLabel" FontSize="11" Opacity="0.6"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Clipboard auto-clear" FontWeight="SemiBold" FontSize="13"/>
                    <Slider x:Name="ClipboardSlider" ValueChanged="Clipboard_Changed"/>
                    <TextBlock x:Name="ClipboardLabel" FontSize="11" Opacity="0.6"/>
                </StackPanel>
            </StackPanel>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- Windows Hello -->
            <StackPanel Spacing="12">
                <TextBlock Text="Windows Hello" FontSize="16" FontWeight="SemiBold" Opacity="0.7"/>
                <TextBlock TextWrapping="WrapWholeWords" Opacity="0.7" FontSize="13">
                    Windows Hello protects access to the vault key protector.
                    When configured, you can unlock with face recognition, fingerprint, or PIN.
                </TextBlock>
                <TextBlock x:Name="HelloStatus" FontSize="13" Opacity="0.8"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SetupHelloBtn" Content="Set up Windows Hello" Click="SetupHello_Click"/>
                    <Button x:Name="RemoveHelloBtn" Content="Remove Hello credential" Click="RemoveHello_Click"/>
                </StackPanel>
            </StackPanel>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- Change master password -->
            <StackPanel Spacing="12">
                <TextBlock Text="Change master password" FontSize="16" FontWeight="SemiBold" Opacity="0.7"/>
                <StackPanel Spacing="8">
                    <PasswordBox x:Name="CurrentPwd" PlaceholderText="Current master password"/>
                    <PasswordBox x:Name="NewPwd" PlaceholderText="New master password" PasswordChanged="NewPwd_Changed"/>
                    <PasswordBox x:Name="NewPwdConfirm" PlaceholderText="Confirm new password"/>
                    <ProgressBar x:Name="NewPwdStrength" Maximum="4" Height="4"/>
                    <TextBlock x:Name="NewPwdStrengthLabel" FontSize="11" Opacity="0.6"/>
                    <Button x:Name="ChangePasswordBtn" Content="Change password" Click="ChangePassword_Click"/>
                </StackPanel>
            </StackPanel>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- Updates (Personal) -->
            <StackPanel x:Name="UpdatesSection" Spacing="12">
                <TextBlock Text="Updates" FontSize="16" FontWeight="SemiBold" Opacity="0.7"/>
                <TextBlock TextWrapping="WrapWholeWords" Opacity="0.7" FontSize="13">
                    Fortiva checks GitHub Releases for verified updates. Routine Windows security patches do not require a new Fortiva install.
                </TextBlock>
                <TextBlock x:Name="UpdateFeedText" FontSize="11" Opacity="0.5" TextWrapping="WrapWholeWords"/>
                <ToggleSwitch x:Name="AutoUpdateSwitch" Header="Automatic updates"
                              OffContent="Off — check manually only"
                              OnContent="On — verify and install in the background"
                              Toggled="AutoUpdate_Toggled"/>
                <TextBlock x:Name="UpdateStatusText" FontSize="12" Opacity="0.7" TextWrapping="WrapWholeWords"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CheckUpdateBtn" Content="Check for updates"
                            Style="{StaticResource FortivaAccentButton}" Click="CheckUpdate_Click"/>
                    <ProgressRing x:Name="UpdateBusyRing" IsActive="False" Width="20" Height="20"/>
                </StackPanel>
            </StackPanel>

            <Border x:Name="UpdatesDivider" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- Portable mode -->
            <StackPanel x:Name="PortableSection" Spacing="12">
                <TextBlock Text="Portable mode" FontSize="16" FontWeight="SemiBold" Opacity="0.7"/>
                <TextBlock TextWrapping="WrapWholeWords" Opacity="0.7" FontSize="13">
                    Store and run your vault from a USB drive. Fortiva remembers your USB location
                    and reopens it automatically when the drive is connected.
                    Note: Windows may leave traces (prefetch, MRU) on the host PC.
                </TextBlock>
                <TextBlock x:Name="PortableStatusText" FontSize="12" Opacity="0.8" TextWrapping="WrapWholeWords"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PortableBtn" Content="Open or create vault on USB…" Click="Portable_Click"/>
                    <Button x:Name="LocalVaultBtn" Content="Use local vault" Click="LocalVault_Click" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>

            <!-- Vault info -->
            <Border Style="{StaticResource FortivaGlassPanelGlow}" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Vault information" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VaultInfoText" FontSize="12" Opacity="0.7"
                               TextWrapping="WrapWholeWords" FontFamily="Consolas"/>
                </StackPanel>
            </Border>

            <InfoBar x:Name="SettingsInfo" IsOpen="False" IsClosable="True"/>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- About -->
            <StackPanel Spacing="6">
                <TextBlock Text="About" FontSize="16" FontWeight="SemiBold" Opacity="0.7"/>
                <Border CornerRadius="8" Padding="16"
                        Background="{ThemeResource FortivaAccentGlowBrush}"
                        BorderBrush="{ThemeResource FortivaGlassBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Image x:Name="AboutLogo" Width="72" Height="72"
                               HorizontalAlignment="Left" Stretch="Uniform"/>
                        <TextBlock x:Name="AboutAppName"   FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AboutVersion"   FontSize="12" Opacity="0.7"/>
                        <TextBlock x:Name="AboutPublisher" FontSize="12" Opacity="0.6"/>
                        <TextBlock FontSize="11" Opacity="0.5" Margin="0,4,0,0"
                                   Text="Zero-knowledge. Local-first. Windows-native."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
