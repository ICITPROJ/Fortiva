<Page
    x:Class="Fortiva.AppHost.Pages.OnboardingPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                  MinWidth="480" MaxWidth="560" Margin="32,24" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource FortivaGlassPanelGlow}" Padding="28">
                    <StackPanel Spacing="4">
                        <!-- Step 0 — Welcome -->
                        <StackPanel x:Name="Step0" Spacing="18">
                            <FontIcon Glyph="&#xE8D7;" FontSize="56" HorizontalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Welcome to Fortiva" Style="{StaticResource FortivaHeroTitle}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock TextWrapping="WrapWholeWords" TextAlignment="Center" Opacity="0.8" FontSize="14" LineHeight="22">
                                Zero-knowledge password management for Windows. Your master password never leaves this device — it derives the key that encrypts your vault locally.
                            </TextBlock>
                            <Border CornerRadius="12" Padding="16"
                                    Background="{ThemeResource FortivaAccentGlowBrush}"
                                    BorderBrush="{ThemeResource FortivaGlassBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="No cloud sync · No telemetry · No backdoor" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE9D5;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="AES-256-GCM + Argon2id via Windows CNG" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE895;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Vault stored only on this device or your USB" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="PortableLocationHint" Visibility="Collapsed"
                                       TextWrapping="WrapWholeWords" TextAlignment="Center"
                                       FontSize="13" Opacity="0.75"/>
                            <Button Content="Get started" HorizontalAlignment="Stretch"
                                    Style="{StaticResource FortivaAccentButton}" Click="NextStep_Click"/>
                        </StackPanel>

                        <!-- Step 1 — Master password -->
                        <StackPanel x:Name="Step1" Visibility="Collapsed" Spacing="16">
                            <TextBlock Text="Create your master password" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock TextWrapping="WrapWholeWords" Opacity="0.8" FontSize="13" LineHeight="20">
                                Choose a strong passphrase — at least 16 characters. You will need this every time you unlock Fortiva.
                            </TextBlock>
                            <Border CornerRadius="12" Padding="14"
                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE946;" FontSize="18"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                        <TextBlock Text="Write it down offline" FontWeight="SemiBold" FontSize="14"/>
                                    </StackPanel>
                                    <TextBlock TextWrapping="WrapWholeWords" FontSize="13" Opacity="0.9" LineHeight="20">
                                        Fortiva cannot reset or recover your master password. Record it on paper and store it somewhere safe — not in email, cloud notes, or another password manager.
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Master password" FontWeight="SemiBold" FontSize="13"/>
                                <PasswordBox x:Name="NewPasswordBox" PlaceholderText="Create a strong passphrase"
                                             PasswordChanged="NewPassword_Changed"/>
                                <ProgressBar x:Name="StrengthBar" Maximum="4" Value="0" Height="6"/>
                                <TextBlock x:Name="StrengthLabel" FontSize="11" Opacity="0.7"/>
                                <TextBlock x:Name="StrengthSuggestion" FontSize="11" Opacity="0.6" TextWrapping="WrapWholeWords"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Confirm master password" FontWeight="SemiBold" FontSize="13"/>
                                <PasswordBox x:Name="ConfirmPasswordBox" PlaceholderText="Confirm your passphrase"/>
                            </StackPanel>
                            <InfoBar x:Name="PasswordErrorBar" IsOpen="False" Severity="Error" IsClosable="True"/>
                            <Grid ColumnSpacing="8">
                                <Button Content="Back" Click="PrevStep_Click"/>
                                <Button Grid.Column="1" Content="Continue" HorizontalAlignment="Stretch"
                                        Style="{StaticResource FortivaAccentButton}" Click="Step1Next_Click"/>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>

                        <!-- Step 2 — Windows Hello -->
                        <StackPanel x:Name="Step2" Visibility="Collapsed" Spacing="16">
                            <FontIcon Glyph="&#xE77B;" FontSize="48" HorizontalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Enable Windows Hello" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock TextWrapping="WrapWholeWords" Opacity="0.8" FontSize="13" LineHeight="20">
                                Face, fingerprint, or PIN unlock adds convenience. Your master password remains the root key — Hello never replaces it.
                            </TextBlock>
                            <InfoBar x:Name="HelloInfoBar" IsOpen="False" Severity="Informational" IsClosable="False"/>
                            <Button x:Name="EnableHelloBtn" Content="Enable Windows Hello"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource FortivaAccentButton}" Click="EnableHello_Click"/>
                            <Grid ColumnSpacing="8">
                                <Button Content="Back" Click="PrevStep_Click"/>
                                <Button x:Name="SkipHelloBtn" Grid.Column="1" Content="Skip for now" Click="HelloSkip_Click"/>
                                <Button x:Name="HelloContinueBtn" Grid.Column="2" Content="Continue"
                                        Visibility="Collapsed" Style="{StaticResource FortivaAccentButton}" Click="HelloContinue_Click"/>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>

                        <!-- Step 3 — Paranoia + offline confirmation -->
                        <StackPanel x:Name="Step3" Visibility="Collapsed" Spacing="16">
                            <FontIcon Glyph="&#xEA8A;" FontSize="48" HorizontalAlignment="Center"
                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                            <TextBlock Text="Final security setup" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock TextWrapping="WrapWholeWords" Opacity="0.8" FontSize="13" LineHeight="20">
                                Paranoia Mode protects against silent vault rollbacks. Confirm you have secured your master password offline before finishing.
                            </TextBlock>
                            <ToggleSwitch x:Name="ParanoiaToggle" Header="Enable Paranoia Mode (recommended)" IsOn="True"/>
                            <Border CornerRadius="12" Padding="14"
                                    BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" BorderThickness="1"
                                    Background="{ThemeResource FortivaAccentGlowBrush}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Offline password backup — required" FontWeight="SemiBold"/>
                                    <TextBlock TextWrapping="WrapWholeWords" FontSize="13" Opacity="0.85" LineHeight="20">
                                        If you lose this password, your vault cannot be opened — even by icmclab studio. Keep a written copy in a safe place (home safe, locked drawer). Consider exporting an encrypted .fvab backup after setup.
                                    </TextBlock>
                                    <CheckBox x:Name="OfflineAckCheck" Content="I have recorded my master password offline in a secure place"
                                              Checked="OfflineAck_Changed" Unchecked="OfflineAck_Changed"/>
                                </StackPanel>
                            </Border>
                            <InfoBar x:Name="FinishErrorBar" IsOpen="False" Severity="Error" IsClosable="True"/>
                            <Grid ColumnSpacing="8">
                                <Button Content="Back" Click="PrevStep_Click"/>
                                <Button x:Name="FinishBtn" Grid.Column="1" Content="Create vault"
                                        IsEnabled="False" HorizontalAlignment="Stretch"
                                        Style="{StaticResource FortivaAccentButton}" Click="FinishOnboarding_Click"/>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Progress pills -->
                <StackPanel x:Name="ProgressDots" Grid.Row="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" Spacing="8">
                    <Border x:Name="Dot0" Width="28" Height="6" CornerRadius="3"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <Border x:Name="Dot1" Width="10" Height="6" CornerRadius="3"
                            Background="{ThemeResource ControlFillColorDefaultBrush}" Opacity="0.5"/>
                    <Border x:Name="Dot2" Width="10" Height="6" CornerRadius="3"
                            Background="{ThemeResource ControlFillColorDefaultBrush}" Opacity="0.5"/>
                    <Border x:Name="Dot3" Width="10" Height="6" CornerRadius="3"
                            Background="{ThemeResource ControlFillColorDefaultBrush}" Opacity="0.5"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Busy overlay during vault creation (Argon2) -->
        <Grid x:Name="BusyOverlay" Visibility="Collapsed" Background="#99000000">
            <Border Style="{StaticResource FortivaGlassPanel}" HorizontalAlignment="Center"
                    VerticalAlignment="Center" MinWidth="300" MaxWidth="360">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <ProgressRing x:Name="BusyRing" IsActive="True" Width="48" Height="48"/>
                    <TextBlock x:Name="BusyTitle" Text="Creating your encrypted vault…"
                               FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock x:Name="BusyDetail" Text="Deriving keys with Argon2id — this may take a few seconds."
                               TextWrapping="WrapWholeWords" TextAlignment="Center" Opacity="0.75" FontSize="13"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
