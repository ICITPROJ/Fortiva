<Page
    x:Class="Fortiva.AppHost.Pages.OnboardingPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="440" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Multi-step wizard: only one step panel visible at a time -->

        <!-- Step 0 — Welcome -->
        <StackPanel x:Name="Step0" Spacing="16">
            <FontIcon Glyph="&#xE8D7;" FontSize="64" HorizontalAlignment="Center"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <TextBlock Text="Welcome to Fortiva" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock TextWrapping="WrapWholeWords" TextAlignment="Center" Opacity="0.75" FontSize="14">
                Fortiva is a zero-knowledge password manager. Your master password is
                never sent anywhere — it only ever lives in your memory and is used
                locally to derive the encryption key that protects your vault.
                If you forget your master password, your data cannot be recovered.
            </TextBlock>
            <Border CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="No cloud sync. No telemetry. No backdoor." FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9D5;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="AES-256-GCM + Argon2id. Windows CNG throughout." FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE895;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="All data stored locally on this device." FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="PortableLocationHint" Visibility="Collapsed"
                       TextWrapping="WrapWholeWords" TextAlignment="Center"
                       FontSize="13" Opacity="0.75"/>
            <Button Content="Get started →" HorizontalAlignment="Stretch"
                    Style="{ThemeResource AccentButtonStyle}" Click="NextStep_Click"/>
        </StackPanel>

        <!-- Step 1 — Create master password -->
        <StackPanel x:Name="Step1" Visibility="Collapsed" Spacing="16">
            <TextBlock Text="Create your master password" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="WrapWholeWords" Opacity="0.75" FontSize="13">
                Choose a strong, memorable passphrase — at least 16 characters.
                You will need this every time you unlock Fortiva.
            </TextBlock>
            <StackPanel Spacing="4">
                <TextBlock Text="Master password" FontWeight="SemiBold" FontSize="13"/>
                <PasswordBox x:Name="NewPasswordBox" PlaceholderText="Create a strong passphrase"
                             PasswordChanged="NewPassword_Changed"/>
                <!-- Strength meter -->
                <ProgressBar x:Name="StrengthBar" Maximum="4" Value="0" Height="6"/>
                <TextBlock x:Name="StrengthLabel" FontSize="11" Opacity="0.7"/>
                <TextBlock x:Name="StrengthSuggestion" FontSize="11" Opacity="0.6"
                           TextWrapping="WrapWholeWords"/>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Confirm master password" FontWeight="SemiBold" FontSize="13"/>
                <PasswordBox x:Name="ConfirmPasswordBox" PlaceholderText="Confirm your passphrase"/>
            </StackPanel>
            <InfoBar x:Name="PasswordErrorBar" IsOpen="False" Severity="Error" IsClosable="True"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="← Back" Click="PrevStep_Click"/>
                <Button Content="Continue →" HorizontalAlignment="Right"
                        Style="{ThemeResource AccentButtonStyle}" Click="Step1Next_Click" Margin="0"/>
            </StackPanel>
        </StackPanel>

        <!-- Step 2 — Windows Hello -->
        <StackPanel x:Name="Step2" Visibility="Collapsed" Spacing="16">
            <FontIcon Glyph="&#xE77B;" FontSize="48" HorizontalAlignment="Center"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <TextBlock Text="Enable Windows Hello" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="WrapWholeWords" Opacity="0.75" FontSize="13">
                Windows Hello (fingerprint or face) can protect access to your vault key,
                letting you unlock Fortiva without typing your full master password each time.
                Your master password remains the ultimate key — Hello is an additional convenience layer.
            </TextBlock>
            <InfoBar x:Name="HelloInfoBar" IsOpen="False" Severity="Informational" IsClosable="False"/>
            <StackPanel Spacing="8">
                <Button x:Name="EnableHelloBtn" Content="Enable Windows Hello"
                        HorizontalAlignment="Stretch"
                        Style="{ThemeResource AccentButtonStyle}" Click="EnableHello_Click"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="← Back" Click="PrevStep_Click"/>
                    <Button x:Name="SkipHelloBtn" Content="Skip for now" Click="HelloSkip_Click"/>
                    <Button x:Name="HelloContinueBtn" Content="Continue →" Visibility="Collapsed"
                            Style="{ThemeResource AccentButtonStyle}" Click="HelloContinue_Click"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Step 3 — Paranoia mode -->
        <StackPanel x:Name="Step3" Visibility="Collapsed" Spacing="16">
            <FontIcon Glyph="&#xEA8A;" FontSize="48" HorizontalAlignment="Center"
                      Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
            <TextBlock Text="Paranoia Mode" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="WrapWholeWords" Opacity="0.75" FontSize="13">
                Paranoia Mode adds additional rollback and downgrade protection.
                If a potential vault rollback is detected, Fortiva opens the vault
                in read-only mode rather than allowing silent data loss.
                Recommended for most users.
            </TextBlock>
            <ToggleSwitch x:Name="ParanoiaToggle" Header="Enable Paranoia Mode (recommended)" IsOn="True"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="← Back" Click="PrevStep_Click"/>
                <Button x:Name="FinishBtn" Content="Finish →" Style="{ThemeResource AccentButtonStyle}" Click="FinishOnboarding_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Step progress indicator — Row 1 so it never overlaps content -->
        <StackPanel x:Name="ProgressDots" Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Center" Spacing="6">
            <Ellipse x:Name="Dot0" Width="8" Height="8" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
            <Ellipse x:Name="Dot1" Width="8" Height="8" Fill="{ThemeResource ControlFillColorDefaultBrush}" Stroke="{ThemeResource DividerStrokeColorDefaultBrush}" StrokeThickness="1"/>
            <Ellipse x:Name="Dot2" Width="8" Height="8" Fill="{ThemeResource ControlFillColorDefaultBrush}" Stroke="{ThemeResource DividerStrokeColorDefaultBrush}" StrokeThickness="1"/>
            <Ellipse x:Name="Dot3" Width="8" Height="8" Fill="{ThemeResource ControlFillColorDefaultBrush}" Stroke="{ThemeResource DividerStrokeColorDefaultBrush}" StrokeThickness="1"/>
        </StackPanel>
    </Grid>
</Page>
