<Page
    x:Class="Fortiva.AppHost.Pages.PasswordGeneratorPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <Border Style="{StaticResource FortivaGlassPanel}" Margin="24" MaxWidth="560" HorizontalAlignment="Center">
            <StackPanel Spacing="16">
                <TextBlock Text="Password generator" Style="{StaticResource FortivaPageTitle}"/>

                <StackPanel x:Name="GeneratorHost" Spacing="10"/>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource FortivaSecondaryButton}" Click="Regenerate_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            <TextBlock Text="Regenerate"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FortivaAccentButton}" Click="Copy_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                            <TextBlock Text="Copy to clipboard"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" Severity="Informational"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
