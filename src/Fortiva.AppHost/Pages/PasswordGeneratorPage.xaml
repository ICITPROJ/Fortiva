<Page
    x:Class="Fortiva.AppHost.Pages.PasswordGeneratorPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource FortivaToolbar}" Padding="24,20,24,16">
            <StackPanel Spacing="4">
                <TextBlock Text="Password generator" Style="{StaticResource FortivaHeroTitle}"/>
                <TextBlock Text="Create strong passwords for new accounts or rotate existing ones."
                           Style="{StaticResource FortivaMutedText}"/>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="PageScroll" Grid.Row="1"
                      Style="{StaticResource FortivaPageScrollViewer}">
            <Border Style="{StaticResource FortivaPagePanel}">
                <StackPanel Spacing="16">
                    <StackPanel x:Name="GeneratorHost" Spacing="0" HorizontalAlignment="Stretch"/>
                    <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" Severity="Informational"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Sticky actions — always visible on RDP / short viewports (not buried in scroll) -->
        <Border Grid.Row="2"
                Style="{StaticResource FortivaToolbar}"
                Padding="24,12,24,16"
                BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="RegenerateBtn" Grid.Column="0"
                        Style="{StaticResource FortivaSecondaryButton}"
                        Click="Regenerate_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock Text="Regenerate"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CopyPasswordBtn" Grid.Column="1"
                        Style="{StaticResource FortivaSecondaryButton}"
                        Click="CopyPassword_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                        <TextBlock Text="Copy"/>
                    </StackPanel>
                </Button>
                <Button x:Name="UsePasswordBtn" Grid.Column="3"
                        Style="{StaticResource FortivaAccentButton}"
                        Click="UsePassword_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock Text="Use password"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
