<Page

    x:Class="Fortiva.AppHost.Pages.PasswordGeneratorPage"

    NavigationCacheMode="Enabled"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    Background="Transparent"

    HorizontalAlignment="Stretch"

    VerticalAlignment="Stretch">



    <Grid RowSpacing="0">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <Border Grid.Row="0" Style="{StaticResource FortivaToolbar}" Padding="24,20,24,16">

            <StackPanel Spacing="4">

                <TextBlock Text="Password generator" Style="{StaticResource FortivaHeroTitle}"/>

                <TextBlock Text="Create strong passwords for new accounts or rotate existing ones."

                           Style="{StaticResource FortivaMutedText}"/>

            </StackPanel>

        </Border>



        <ScrollViewer x:Name="PageScroll" Grid.Row="1"

                      HorizontalScrollBarVisibility="Disabled"

                      VerticalScrollBarVisibility="Auto"

                      HorizontalContentAlignment="Stretch">

            <Border Style="{StaticResource FortivaGlassPanelGlow}" Margin="24,16,24,24"

                    HorizontalAlignment="Stretch" MinWidth="560"

                    Width="{Binding ViewportWidth, ElementName=PageScroll}">

                <StackPanel Spacing="20">

                    <StackPanel x:Name="GeneratorHost" Spacing="0"/>



                    <Border BorderBrush="{ThemeResource FortivaInputBorderBrush}"

                            BorderThickness="0,1,0,0" Padding="0,16,0,0">

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">

                            <Button x:Name="RegenerateBtn" Style="{StaticResource FortivaSecondaryButton}"

                                    Click="Regenerate_Click">

                                <StackPanel Orientation="Horizontal" Spacing="6">

                                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>

                                    <TextBlock Text="Regenerate"/>

                                </StackPanel>

                            </Button>

                            <Button x:Name="CopyPasswordBtn" Style="{StaticResource FortivaSecondaryButton}"
                                    Click="CopyPassword_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                                    <TextBlock Text="Copy"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="UsePasswordBtn" Style="{StaticResource FortivaAccentButton}"

                                    Click="UsePassword_Click">

                                <StackPanel Orientation="Horizontal" Spacing="6">

                                    <FontIcon Glyph="&#xE8C8;" FontSize="14"/>

                                    <TextBlock Text="Use password"/>

                                </StackPanel>

                            </Button>

                        </StackPanel>

                    </Border>



                    <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" Severity="Informational"/>

                </StackPanel>

            </Border>

        </ScrollViewer>

    </Grid>

</Page>

