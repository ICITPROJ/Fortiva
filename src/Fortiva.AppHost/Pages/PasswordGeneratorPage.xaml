<Page
    x:Class="Fortiva.AppHost.Pages.PasswordGeneratorPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Center">
            <TextBlock Text="Password generator" FontSize="24" FontWeight="SemiBold"/>

            <StackPanel x:Name="GeneratorHost" Spacing="10"/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="Regenerate_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock Text="Regenerate"/>
                    </StackPanel>
                </Button>
                <Button Style="{ThemeResource AccentButtonStyle}" Click="Copy_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                        <TextBlock Text="Copy to clipboard"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" Severity="Informational"/>
        </StackPanel>
    </ScrollViewer>
</Page>
