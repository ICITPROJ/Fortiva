<Page
    x:Class="Fortiva.AppHost.Pages.UnlockPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
          MaxWidth="440" MinWidth="320" Margin="24">
        <Border Style="{StaticResource FortivaGlassPanelGlow}" Padding="36,32">
            <Grid RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel HorizontalAlignment="Center" Spacing="12">
                    <Image x:Name="BrandLogo" Width="72" Height="72"
                           HorizontalAlignment="Center" Stretch="Uniform"/>
                    <TextBlock x:Name="HeadingText" Style="{StaticResource FortivaHeroTitle}"
                               HorizontalAlignment="Center" Text="Unlock vault"/>
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource FortivaBodyText}" FontSize="13"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Text="Enter your master password to continue."/>
                </StackPanel>

                <InfoBar x:Name="ErrorBar" Grid.Row="1" IsOpen="False"
                         Severity="Error" IsClosable="True"/>

                <InfoBar x:Name="RollbackBar" Grid.Row="2" IsOpen="False"
                         Severity="Warning" Title="Security notice"
                         IsClosable="False"/>

                <StackPanel x:Name="PasswordSection" Grid.Row="3" Spacing="8">
                    <TextBlock Text="Master password" Style="{StaticResource FortivaFieldLabel}"/>
                    <PasswordBox x:Name="PasswordField"
                                 Style="{StaticResource FortivaPasswordBox}"
                                 PlaceholderText="Enter master password"
                                 KeyDown="PasswordField_KeyDown"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Spacing="8">
                    <Button x:Name="HelloBtn" HorizontalAlignment="Stretch" Click="HelloBtn_Click" Visibility="Collapsed"
                            Style="{StaticResource FortivaAccentButton}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE77B;" FontSize="16"/>
                            <TextBlock Text="Unlock with Windows Hello (PIN, face, or fingerprint)"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="UnlockBtn" Content="Unlock with master password" HorizontalAlignment="Stretch"
                            Style="{StaticResource FortivaSecondaryButton}" Click="UnlockBtn_Click"/>
                    <HyperlinkButton x:Name="UsePasswordInsteadBtn" Content="Use master password instead"
                                     HorizontalAlignment="Center" Visibility="Collapsed" Click="UsePasswordInstead_Click"/>
                    <ProgressRing x:Name="BusyRing" IsActive="False" Width="28" Height="28"
                                  HorizontalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>

                <TextBlock Grid.Row="5"
                           Style="{StaticResource FortivaHelperText}"
                           TextAlignment="Center"
                           Text="Lost your master password? Fortiva cannot recover it - use an offline backup or encrypted .fva export if you have one."/>
            </Grid>
        </Border>
    </Grid>
</Page>
