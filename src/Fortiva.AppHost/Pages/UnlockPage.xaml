<Page
    x:Class="Fortiva.AppHost.Pages.UnlockPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="360" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Logo + title -->
        <StackPanel HorizontalAlignment="Center" Spacing="12">
            <Image x:Name="BrandLogo" Width="72" Height="72"
                   HorizontalAlignment="Center" Stretch="Uniform"/>
            <TextBlock x:Name="HeadingText" FontSize="26" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Text="Unlock Vault"/>
            <TextBlock x:Name="SubtitleText" FontSize="13" Opacity="0.65"
                       HorizontalAlignment="Center" Text="Enter your master password to continue."/>
        </StackPanel>

        <!-- Error InfoBar -->
        <InfoBar x:Name="ErrorBar" Grid.Row="1" IsOpen="False"
                 Severity="Error" IsClosable="True"/>

        <!-- Rollback InfoBar -->
        <InfoBar x:Name="RollbackBar" Grid.Row="2" IsOpen="False"
                 Severity="Warning" Title="Security notice"
                 IsClosable="False"/>

        <!-- Password field -->
        <StackPanel Grid.Row="3" Spacing="8">
            <TextBlock Text="Master password" FontWeight="SemiBold" FontSize="13"/>
            <PasswordBox x:Name="PasswordField"
                         PlaceholderText="Enter master password"
                         KeyDown="PasswordField_KeyDown"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Spacing="8">
            <Button x:Name="UnlockBtn" Content="Unlock" HorizontalAlignment="Stretch"
                    Style="{ThemeResource AccentButtonStyle}" Click="UnlockBtn_Click"/>
            <Button x:Name="HelloBtn" HorizontalAlignment="Stretch" Click="HelloBtn_Click" Visibility="Collapsed">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE77B;" FontSize="16"/>
                            <TextBlock Text="Unlock with Windows Hello or PIN"/>
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>
        </StackPanel>

        <!-- Loading ring -->
        <ProgressRing x:Name="BusyRing" Grid.Row="5" IsActive="False"
                      HorizontalAlignment="Center" Width="32" Height="32"/>
    </Grid>
</Page>
