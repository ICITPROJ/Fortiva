<Page
    x:Class="Fortiva.AppHost.Pages.HealthPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="HealthEntryTemplate" x:DataType="local:HealthEntryDisplay"
                      xmlns:local="using:Fortiva.AppHost.Pages">
            <Grid Padding="4,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="8"
                        Background="{ThemeResource AccentFillColorTertiaryBrush}">
                    <TextBlock Text="{x:Bind Initial}" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource FortivaAccentIconBrush}"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource FortivaHeadingBrush}"/>
                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource FortivaMutedText}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="6" Padding="8,4" VerticalAlignment="Center"
                        Background="{x:Bind IssueBadgeBrush}">
                    <TextBlock Text="{x:Bind IssueLabel}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{x:Bind IssueTextBrush}"/>
                </Border>
                <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="12"
                          Foreground="{ThemeResource FortivaMutedBrush}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ImportDuplicateTemplate" x:DataType="local:ImportDuplicateDisplay"
                      xmlns:local="using:Fortiva.AppHost.Pages">
            <Grid Padding="4,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource FortivaHeadingBrush}"/>
                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource FortivaMutedText}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind BatchLabel}" FontSize="11" Style="{StaticResource FortivaMutedText}"/>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorTertiaryBrush}">
                    <TextBlock Text="Kept existing" FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource FortivaAccentIconBrush}"/>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer x:Name="PageScroll" Style="{StaticResource FortivaPageScrollViewer}">
        <StackPanel Spacing="24" MaxWidth="960" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Security audit" Style="{StaticResource FortivaPageTitle}"/>
                    <TextBlock Text="Full vault scan - passwords, settings, vault hygiene, and activity."
                               Style="{StaticResource FortivaBodyText}" TextWrapping="WrapWholeWords"/>
                    <TextBlock x:Name="LastRunLabel" Style="{StaticResource FortivaMutedText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button x:Name="RunAuditBtn" Style="{StaticResource FortivaAccentButton}" Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14"/>
                            <TextBlock Text="Run full audit"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="GeneratorBtn" Style="{StaticResource FortivaSecondaryButton}" Click="OpenGenerator_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D5;" FontSize="14"/>
                            <TextBlock Text="Password generator"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportAuditBtn" Style="{StaticResource FortivaSecondaryButton}" Click="ExportAudit_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEA53;" FontSize="14"/>
                            <TextBlock Text="Export report"/>
                        </StackPanel>
                    </Button>
                    <ProgressRing x:Name="LoadingRing" IsActive="False" Width="24" Height="24"/>
                </StackPanel>
            </Grid>

            <!-- Category summary -->
            <Grid x:Name="CategoryGrid" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="CatPasswords" Style="{StaticResource FortivaGlassPanel}" Padding="16"
                        PointerPressed="CatPasswords_Pressed">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE72E;" FontSize="20" Foreground="{ThemeResource FortivaAccentIconBrush}"/>
                        <TextBlock x:Name="CatPasswordsCount" FontSize="22" FontWeight="Bold"
                                   Foreground="{ThemeResource FortivaHeadingBrush}"/>
                        <TextBlock Text="Password issues" Style="{StaticResource FortivaMutedText}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" x:Name="CatSettings" Style="{StaticResource FortivaGlassPanel}" Padding="16"
                        PointerPressed="CatSettings_Pressed">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE713;" FontSize="20" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                        <TextBlock x:Name="CatSettingsCount" FontSize="22" FontWeight="Bold"
                                   Foreground="{ThemeResource FortivaHeadingBrush}"/>
                        <TextBlock Text="Settings" Style="{StaticResource FortivaMutedText}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" x:Name="CatVault" Style="{StaticResource FortivaGlassPanel}" Padding="16"
                        PointerPressed="CatVault_Pressed">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE8D7;" FontSize="20" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                        <TextBlock x:Name="CatVaultCount" FontSize="22" FontWeight="Bold"
                                   Foreground="{ThemeResource FortivaHeadingBrush}"/>
                        <TextBlock Text="Vault hygiene" Style="{StaticResource FortivaMutedText}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" x:Name="CatActivity" Style="{StaticResource FortivaGlassPanel}" Padding="16"
                        PointerPressed="CatActivity_Pressed">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE81C;" FontSize="20" Foreground="{ThemeResource SystemFillColorNeutralBrush}"/>
                        <TextBlock x:Name="CatActivityCount" FontSize="22" FontWeight="Bold"
                                   Foreground="{ThemeResource FortivaHeadingBrush}"/>
                        <TextBlock Text="Activity" Style="{StaticResource FortivaMutedText}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Hero score -->
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="ScoreRing" Width="156" Height="156" CornerRadius="78"
                        BorderThickness="8" Padding="0"
                        Background="{ThemeResource FortivaGlassFillBrush}"
                        BorderBrush="{ThemeResource FortivaGlassBorderBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                        <TextBlock x:Name="ScoreValue" FontSize="48" FontWeight="Bold"
                                   Foreground="{ThemeResource FortivaHeadingBrush}"
                                   HorizontalAlignment="Center" LineHeight="48"/>
                        <TextBlock Text="/ 100" Style="{StaticResource FortivaMutedText}" FontSize="14"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ScoreGrade" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource FortivaHeadingBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Center">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="ScoreHeading" FontSize="22" FontWeight="SemiBold" TextWrapping="WrapWholeWords"
                                   Foreground="{ThemeResource FortivaHeadingBrush}"/>
                        <TextBlock x:Name="ScoreDetail" Style="{StaticResource FortivaBodyText}"/>
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FortivaGlassPanel}" Padding="14" PointerPressed="PassStat_Pressed">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="PassStat" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                <TextBlock Text="Passed checks" Style="{StaticResource FortivaMutedText}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource FortivaGlassPanel}" Padding="14" PointerPressed="WarnStat_Pressed">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="WarnStat" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                <TextBlock Text="Warnings" Style="{StaticResource FortivaMutedText}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource FortivaGlassPanel}" Padding="14" PointerPressed="CritStat_Pressed">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="CritStat" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                <TextBlock Text="Critical" Style="{StaticResource FortivaMutedText}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource FortivaGlassPanel}" Padding="14">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="SecureStat" FontSize="22" FontWeight="Bold"
                                           Foreground="{ThemeResource FortivaHeadingBrush}"/>
                                <TextBlock Text="Strong logins" Style="{StaticResource FortivaMutedText}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Full findings -->
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource FortivaAccentIconBrush}"/>
                    <TextBlock Text="Audit findings" Style="{StaticResource FortivaSectionTitle}"/>
                </StackPanel>
                <Border x:Name="FilterBanner" Visibility="Collapsed" Style="{StaticResource FortivaGlassPanel}" Padding="12,10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FilterBannerText" VerticalAlignment="Center" Style="{StaticResource FortivaBodyText}"/>
                        <Button Grid.Column="1" Content="Clear filter" Style="{StaticResource FortivaSecondaryButton}" Click="ClearFilter_Click"/>
                    </Grid>
                </Border>
                <StackPanel x:Name="FindingsPanel" Spacing="10"/>
            </StackPanel>

            <Expander x:Name="ImportDuplicatesExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Visibility="Collapsed">
                <ListView x:Name="ImportDuplicatesList" SelectionMode="Single" MaxHeight="320"
                          ItemTemplate="{StaticResource ImportDuplicateTemplate}"
                          SelectionChanged="ImportDuplicatesList_SelectionChanged"/>
            </Expander>

            <!-- Strength breakdown -->
            <Border Style="{StaticResource FortivaGlassPanel}" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9D2;" FontSize="16" Foreground="{ThemeResource FortivaAccentIconBrush}"/>
                        <TextBlock Text="Password strength breakdown" Style="{StaticResource FortivaSectionTitle}"/>
                    </StackPanel>
                    <StackPanel x:Name="StrengthBarsPanel" Spacing="10"/>
                </StackPanel>
            </Border>

            <!-- Password issue cards -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="TotalCard" Style="{StaticResource FortivaGlassPanel}" Padding="16" PointerPressed="TotalCard_Pressed">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE8C1;" FontSize="24" Foreground="{ThemeResource FortivaAccentIconBrush}"/>
                        <TextBlock x:Name="TotalCount" FontSize="26" FontWeight="Bold"
                                   Foreground="{ThemeResource FortivaHeadingBrush}"/>
                        <TextBlock Text="Saved logins" Style="{StaticResource FortivaMutedText}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" x:Name="WeakCard" Style="{StaticResource FortivaGlassPanel}" Padding="16" PointerPressed="WeakCard_Pressed">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xEA3A;" FontSize="24" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                        <TextBlock x:Name="WeakCount" FontSize="26" FontWeight="Bold"
                                   Foreground="{ThemeResource FortivaHeadingBrush}"/>
                        <TextBlock Text="Weak" Style="{StaticResource FortivaMutedText}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" x:Name="ReusedCard" Style="{StaticResource FortivaGlassPanel}" Padding="16" PointerPressed="ReusedCard_Pressed">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE8AB;" FontSize="24" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                        <TextBlock x:Name="ReusedCount" FontSize="26" FontWeight="Bold"
                                   Foreground="{ThemeResource FortivaHeadingBrush}"/>
                        <TextBlock Text="Reused" Style="{StaticResource FortivaMutedText}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" x:Name="OldCard" Style="{StaticResource FortivaGlassPanel}" Padding="16" PointerPressed="OldCard_Pressed">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE787;" FontSize="24" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                        <TextBlock x:Name="OldCount" FontSize="26" FontWeight="Bold"
                                   Foreground="{ThemeResource FortivaHeadingBrush}"/>
                        <TextBlock Text="Old (1y+)" Style="{StaticResource FortivaMutedText}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" x:Name="MissingCard" Style="{StaticResource FortivaGlassPanel}" Padding="16" PointerPressed="MissingCard_Pressed">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE946;" FontSize="24" Foreground="{ThemeResource SystemFillColorNeutralBrush}"/>
                        <TextBlock x:Name="MissingCount" FontSize="26" FontWeight="Bold"
                                   Foreground="{ThemeResource FortivaHeadingBrush}"/>
                        <TextBlock Text="Missing" Style="{StaticResource FortivaMutedText}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Expander x:Name="WeakExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <ListView x:Name="WeakList" SelectionMode="Single" MaxHeight="280"
                          ItemTemplate="{StaticResource HealthEntryTemplate}"
                          SelectionChanged="HealthList_SelectionChanged"/>
            </Expander>
            <Expander x:Name="ReusedExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <ListView x:Name="ReusedList" SelectionMode="Single" MaxHeight="280"
                          ItemTemplate="{StaticResource HealthEntryTemplate}"
                          SelectionChanged="HealthList_SelectionChanged"/>
            </Expander>
            <Expander x:Name="OldExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <ListView x:Name="OldList" SelectionMode="Single" MaxHeight="280"
                          ItemTemplate="{StaticResource HealthEntryTemplate}"
                          SelectionChanged="HealthList_SelectionChanged"/>
            </Expander>
            <Expander x:Name="MissingExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <ListView x:Name="MissingList" SelectionMode="Single" MaxHeight="280"
                          ItemTemplate="{StaticResource HealthEntryTemplate}"
                          SelectionChanged="HealthList_SelectionChanged"/>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
