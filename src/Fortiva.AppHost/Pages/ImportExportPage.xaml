<Page
    x:Class="Fortiva.AppHost.Pages.ImportExportPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer x:Name="PageScroll"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <Border Style="{StaticResource FortivaGlassPanel}" Margin="24"
                HorizontalAlignment="Stretch" MinWidth="320"
                Width="{Binding ViewportWidth, ElementName=PageScroll}">
        <StackPanel Spacing="24">
            <TextBlock Text="Import / Export" Style="{StaticResource FortivaPageTitle}"/>

            <!-- Import section -->
            <StackPanel Spacing="16">
                <TextBlock Text="Import" Style="{StaticResource FortivaSectionTitle}"/>
                <TextBlock TextWrapping="WrapWholeWords" Style="{StaticResource FortivaBodyText}" FontSize="13">
                    Import credentials from a CSV file, KeePass CSV export, or a browser export.
                    Imported entries are added to your existing vault.
                </TextBlock>
                <ComboBox x:Name="ImportFormatBox" Header="Source format" Style="{StaticResource FortivaComboBox}" Width="280" SelectedIndex="0">
                    <ComboBoxItem>Generic CSV (name, username, password, url, notes)</ComboBoxItem>
                    <ComboBoxItem>KeePass CSV export</ComboBoxItem>
                    <ComboBoxItem>Browser CSV (Chrome / Edge / Firefox - same columns)</ComboBoxItem>
                </ComboBox>
                <Button x:Name="ImportBtn" Style="{StaticResource FortivaSecondaryButton}" Click="Import_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B5;" FontSize="14"/>
                        <TextBlock Text="Choose file and import…"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- Export section -->
            <StackPanel Spacing="16">
                <TextBlock Text="Export" Style="{StaticResource FortivaSectionTitle}"/>
                <TextBlock TextWrapping="WrapWholeWords" Style="{StaticResource FortivaBodyText}" FontSize="13">
                    Export your vault for backup or migration.
                    Encrypted export is always available. Plaintext CSV export requires explicit confirmation
                    and is blocked by strict enterprise policies.
                </TextBlock>
                <Button x:Name="ExportEncryptedBtn" Style="{StaticResource FortivaAccentButton}" Click="ExportEncrypted_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72E;" FontSize="14"/>
                        <TextBlock Text="Export encrypted (.fva backup)"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ExportCsvBtn" Style="{StaticResource FortivaSecondaryButton}" Click="ExportCsv_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                        <TextBlock Text="Export as plaintext CSV…"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True"/>
        </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
