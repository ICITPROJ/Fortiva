<Page
    x:Class="Fortiva.AppHost.Pages.ImportExportPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource FortivaToolbar}" Padding="24,20,24,16">
            <StackPanel Spacing="4">
                <TextBlock Text="Import / Export" Style="{StaticResource FortivaHeroTitle}"/>
                <TextBlock Text="Move credentials in or out — previews and conflicts before anything is saved."
                           Style="{StaticResource FortivaMutedText}"/>
            </StackPanel>
        </Border>

    <ScrollViewer x:Name="PageScroll" Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <Border Style="{StaticResource FortivaGlassPanel}" Margin="24"
                HorizontalAlignment="Stretch" MinWidth="320"
                Width="{Binding ViewportWidth, ElementName=PageScroll}">
        <StackPanel Spacing="24">

            <!-- Import section -->
            <StackPanel Spacing="16">
                <TextBlock Text="Import" Style="{StaticResource FortivaSectionTitle}"/>
                <TextBlock TextWrapping="WrapWholeWords" Style="{StaticResource FortivaBodyText}" FontSize="13">
                    Import credentials from another password manager or browser export.
                    Fortiva previews new, duplicate, and conflicting entries before anything is saved —
                    nothing is overwritten without your choice.
                </TextBlock>
                <ComboBox x:Name="ImportFormatBox" Header="Source format" Style="{StaticResource FortivaComboBox}" Width="360" SelectedIndex="0">
                    <ComboBoxItem>Generic CSV (name, username, password, url, notes)</ComboBoxItem>
                    <ComboBoxItem>KeePass CSV export</ComboBoxItem>
                    <ComboBoxItem>Browser CSV (Chrome / Edge / Firefox)</ComboBoxItem>
                    <ComboBoxItem>Apple iPhone / iCloud Keychain CSV</ComboBoxItem>
                    <ComboBoxItem>Fortiva encrypted backup (.fva)</ComboBoxItem>
                </ComboBox>
                <Button x:Name="ImportBtn" Style="{StaticResource FortivaSecondaryButton}" Click="Import_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B5;" FontSize="14"/>
                        <TextBlock Text="Choose file and review import…"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border Style="{StaticResource FortivaSectionDivider}"/>

            <!-- Import history -->
            <StackPanel Spacing="12">
                <TextBlock Text="Import history" Style="{StaticResource FortivaSectionTitle}"/>
                <TextBlock x:Name="ImportHistoryHint" TextWrapping="WrapWholeWords" Style="{StaticResource FortivaMutedText}" FontSize="13"
                           Text="After you import, each batch appears here with your name, notes, date, and counts. View entries from any import."/>
                <ListView x:Name="ImportHistoryList" SelectionMode="Single" SelectionChanged="ImportHistory_SelectionChanged"
                          MaxHeight="280" Visibility="Collapsed">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="2" Padding="4,8">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource FortivaMutedText}" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button x:Name="ViewImportEntriesBtn" Style="{StaticResource FortivaSecondaryButton}"
                        Visibility="Collapsed" Click="ViewImportEntries_Click">
                    <TextBlock Text="View entries from selected import"/>
                </Button>
                <Button x:Name="ReviewImportDuplicatesBtn" Style="{StaticResource FortivaSecondaryButton}"
                        Visibility="Collapsed" Click="ReviewImportDuplicates_Click">
                    <TextBlock Text="Review skipped duplicates from selected import"/>
                </Button>
            </StackPanel>

            <Border Style="{StaticResource FortivaSectionDivider}"/>

            <!-- Duplicate management -->
            <StackPanel Spacing="12">
                <TextBlock Text="Duplicate management" Style="{StaticResource FortivaSectionTitle}"/>
                <TextBlock TextWrapping="WrapWholeWords" Style="{StaticResource FortivaMutedText}" FontSize="13"
                           Text="After imports, review skipped duplicates and scan the vault for overlapping logins. Fortiva never removes entries without your explicit action."/>
                <Button x:Name="ScanVaultDuplicatesBtn" Style="{StaticResource FortivaSecondaryButton}" Click="ScanVaultDuplicates_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                        <TextBlock Text="Scan vault for duplicate logins"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="VaultDuplicateSummary" Style="{StaticResource FortivaMutedText}" FontSize="13" Visibility="Collapsed"/>
                <ListView x:Name="VaultDuplicateList" SelectionMode="Single" MaxHeight="240" Visibility="Collapsed"
                          SelectionChanged="VaultDuplicateList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="2" Padding="4,8">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource FortivaMutedText}" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button x:Name="OpenVaultDuplicateEntryBtn" Style="{StaticResource FortivaSecondaryButton}"
                        Visibility="Collapsed" Click="OpenVaultDuplicateEntry_Click">
                    <TextBlock Text="Open selected entry"/>
                </Button>
            </StackPanel>

            <Border Style="{StaticResource FortivaSectionDivider}"/>

            <!-- Export section -->
            <StackPanel Spacing="16">
                <TextBlock Text="Export" Style="{StaticResource FortivaSectionTitle}"/>
                <TextBlock TextWrapping="WrapWholeWords" Style="{StaticResource FortivaBodyText}" FontSize="13">
                    Export your vault for backup or migration.
                    Encrypted export is always available. Plaintext CSV export requires explicit confirmation
                    and is blocked by strict enterprise policies.
                </TextBlock>
                <Button x:Name="ExportEncryptedBtn" Style="{StaticResource FortivaAccentButton}" Click="ExportEncrypted_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72E;" FontSize="14"/>
                        <TextBlock Text="Export encrypted (.fva backup)"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ExportCsvBtn" Style="{StaticResource FortivaSecondaryButton}" Click="ExportCsv_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                        <TextBlock Text="Export as plaintext CSV…"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True"/>
        </StackPanel>
        </Border>
    </ScrollViewer>
    </Grid>
</Page>
