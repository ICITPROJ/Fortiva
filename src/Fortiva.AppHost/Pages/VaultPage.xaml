<Page
    x:Class="Fortiva.AppHost.Pages.VaultPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Fortiva.AppHost.Services"
    Background="Transparent"
    SizeChanged="Page_SizeChanged">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hero + actions -->
        <Border Grid.Row="0" Style="{StaticResource FortivaToolbar}" Padding="24,20,24,16">
            <StackPanel Spacing="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="My Vault" Style="{StaticResource FortivaHeroTitle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="VaultSubtitle" Style="{StaticResource FortivaMutedText}"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="ClearImportFilterBtn" Visibility="Collapsed"
                                    Style="{StaticResource FortivaSecondaryButton}"
                                    Padding="8,2" FontSize="11"
                                    Content="Show all entries"
                                    Click="ClearImportFilter_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="GeneratePasswordBtn"
                                ToolTipService.ToolTip="Generate a password (Ctrl+G)" Click="GeneratePassword_Click"
                                Style="{StaticResource FortivaSecondaryButton}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE9D5;" FontSize="14"/>
                                <TextBlock Text="Generate"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddEntryBtn" Click="AddEntry_Click" ToolTipService.ToolTip="Quick add entry (Ctrl+N)"
                                Style="{StaticResource FortivaAccentButton}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                <TextBlock Text="Add entry"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="SearchBox"
                                    Style="{StaticResource FortivaSearchBox}"
                                    PlaceholderText="Search by title, username, URL, or tag…"
                                    QueryIcon="Find"
                                    TextChanged="SearchBox_TextChanged"/>

                    <Border Grid.Column="1" Style="{StaticResource FortivaVaultStatChip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE734;" FontSize="12" Foreground="{ThemeResource FortivaMutedBrush}"/>
                            <TextBlock x:Name="StatFavorites" Style="{StaticResource FortivaMutedText}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource FortivaVaultStatChip}"
                            ToolTipService.ToolTip="Entries with authenticator (TOTP)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE192;" FontSize="12" Foreground="{ThemeResource FortivaMutedBrush}"/>
                            <TextBlock x:Name="StatTotp" Style="{StaticResource FortivaMutedText}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource FortivaVaultStatChip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource FortivaMutedBrush}"/>
                            <TextBlock x:Name="StatVaultTrust" Style="{StaticResource FortivaMutedText}"/>
                        </StackPanel>
                    </Border>
                    <ToggleButton x:Name="GridViewBtn" Grid.Column="4"
                                  Style="{StaticResource FortivaViewToggleButton}"
                                  IsChecked="True" ToolTipService.ToolTip="Card view"
                                  Click="ViewMode_Click">
                        <FontIcon Glyph="&#xF0E2;" FontSize="14"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ListViewBtn" Grid.Column="5"
                                  Style="{StaticResource FortivaViewToggleButton}"
                                  ToolTipService.ToolTip="List view (compact)"
                                  Click="ViewMode_Click">
                        <FontIcon Glyph="&#xE8FD;" FontSize="14"/>
                    </ToggleButton>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Read-only warning -->
        <InfoBar x:Name="ReadOnlyBar" Grid.Row="1" Margin="24,12,24,0"
                 Title="Read-only vault"
                 Message="A potential rollback was detected. The vault is open in read-only mode."
                 Severity="Warning" IsOpen="False" IsClosable="False">
            <InfoBar.ActionButton>
                <Button x:Name="EnableEditingBtn" Content="Enable editing" Click="EnableEditing_Click"/>
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Entry grid + category sidebar -->
        <Grid Grid.Row="2" Margin="24,16,24,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="DetailColumn" Width="0"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
            <GridView x:Name="EntryGrid"
                      SelectionMode="Extended"
                      IsItemClickEnabled="False"
                      SelectionChanged="EntryGrid_SelectionChanged"
                      ContainerContentChanging="EntryContainer_ContentChanging">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem" BasedOn="{StaticResource FortivaVaultGridItem}"/>
                </GridView.ItemContainerStyle>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="0"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FortivaVaultCard}" HorizontalAlignment="Stretch" MinWidth="320">
                            <Grid ColumnSpacing="12" VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Width="44" Height="44" VerticalAlignment="Top">
                                    <Border CornerRadius="12"
                                            Background="{Binding AvatarBackground}"
                                            BorderBrush="{Binding AvatarBorder}"
                                            BorderThickness="1"
                                            Visibility="{Binding HasFavicon, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                        <TextBlock Text="{Binding Initial}" FontSize="17" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding AvatarForeground}"/>
                                    </Border>
                                    <Image Source="{Binding FaviconFileUri}" Width="28" Height="28"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasFavicon, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>

                                <StackPanel Grid.Column="1" MinWidth="0" VerticalAlignment="Top" Spacing="2">
                                    <Grid ColumnSpacing="6" MinWidth="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold"
                                                   FontSize="15" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource FortivaHeadingBrush}"
                                                   ToolTipService.ToolTip="{Binding Title}"/>
                                        <FontIcon Grid.Column="1" Glyph="&#xE734;" FontSize="11"
                                                  Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  Foreground="{ThemeResource FortivaAccentBrush}"/>
                                    </Grid>
                                    <TextBlock Text="Secure note" Style="{StaticResource FortivaMutedText}"
                                               Visibility="{Binding IsSecureNoteEntry, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding UsernameLine}" Style="{StaticResource FortivaMutedText}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{Binding UsernameLine}"
                                               Visibility="{Binding HasUsernameLine, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding DetailLine}" Style="{StaticResource FortivaMutedText}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{Binding DetailLine}"
                                               Visibility="{Binding HasDetailLine, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding ImportSourceLine}" Style="{StaticResource FortivaMutedText}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{Binding ImportProvenanceLine}"
                                               Visibility="{Binding HasImportSourceLine, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="No username or URL" Style="{StaticResource FortivaMutedText}"
                                               Visibility="{Binding HasMissingDetails, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0"
                                                Visibility="{Binding HasTagChip, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border Style="{StaticResource FortivaTagChip}" MaxWidth="280">
                                            <TextBlock Text="{Binding TagChip}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{Binding TagChip}"
                                                       Foreground="{ThemeResource FortivaHeadingBrush}"/>
                                        </Border>
                                        <Border Style="{StaticResource FortivaTagChip}"
                                                Visibility="{Binding HasExtraTags, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding ExtraTagsLabel}" FontSize="11"
                                                       Foreground="{ThemeResource FortivaMutedBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0"
                                            VerticalAlignment="Top">
                                    <Button Tag="{Binding}"
                                            Visibility="{Binding HasTotp, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTipService.ToolTip="Copy authenticator code"
                                            Style="{StaticResource FortivaIconButton}"
                                            Click="CopyOtp_Click">
                                        <FontIcon Glyph="&#xE192;" FontSize="13"/>
                                    </Button>
                                    <Button Tag="{Binding}"
                                            ToolTipService.ToolTip="Copy username"
                                            Style="{StaticResource FortivaIconButton}"
                                            Click="CopyUsername_Click">
                                        <FontIcon Glyph="&#xE779;" FontSize="13"/>
                                    </Button>
                                    <Button Tag="{Binding}"
                                            ToolTipService.ToolTip="Copy password"
                                            Style="{StaticResource FortivaIconButton}"
                                            Click="CopyPassword_Click">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="13"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <ListView x:Name="EntryList" Visibility="Collapsed"
                      SelectionMode="Extended"
                      IsItemClickEnabled="False"
                      SelectionChanged="EntryList_SelectionChanged"
                      ContainerContentChanging="EntryContainer_ContentChanging">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource FortivaVaultListItem}"/>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FortivaVaultListRow}" HorizontalAlignment="Stretch">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="40" Height="40" VerticalAlignment="Center">
                                    <Border CornerRadius="10"
                                            Background="{Binding AvatarBackground}"
                                            BorderBrush="{Binding AvatarBorder}"
                                            BorderThickness="1"
                                            Visibility="{Binding HasFavicon, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                        <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding AvatarForeground}"/>
                                    </Border>
                                    <Image Source="{Binding FaviconFileUri}" Width="24" Height="24"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasFavicon, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" MinWidth="0">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <FontIcon Grid.Column="1" Glyph="&#xE734;" FontSize="11"
                                                  Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  Foreground="{ThemeResource FortivaAccentBrush}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource FortivaMutedText}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                                    <Button Tag="{Binding}"
                                            Visibility="{Binding HasTotp, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTipService.ToolTip="Copy authenticator code"
                                            Style="{StaticResource FortivaIconButton}"
                                            Click="CopyOtp_Click">
                                        <FontIcon Glyph="&#xE192;" FontSize="13"/>
                                    </Button>
                                    <Button Tag="{Binding}"
                                            ToolTipService.ToolTip="Copy username"
                                            Style="{StaticResource FortivaIconButton}"
                                            Click="CopyUsername_Click">
                                        <FontIcon Glyph="&#xE779;" FontSize="13"/>
                                    </Button>
                                    <Button Tag="{Binding}" Style="{StaticResource FortivaIconButton}"
                                            ToolTipService.ToolTip="Copy password" Click="CopyPassword_Click">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="13"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border x:Name="EmptyState" Visibility="Collapsed"
                    Style="{StaticResource FortivaGlassPanelGlow}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="40,36" MaxWidth="480">
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE8D7;" FontSize="48"
                              Foreground="{ThemeResource FortivaAccentBrush}" Opacity="0.85"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="Your vault is ready" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource FortivaHeadingBrush}"/>
                    <TextBlock Text="Add your first login — passwords stay on this device, encrypted and offline."
                               TextWrapping="WrapWholeWords" TextAlignment="Center"
                               Style="{StaticResource FortivaBodyText}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Style="{StaticResource FortivaAccentButton}" Click="AddEntry_Click" Content="Quick add entry"/>
                        <Button Style="{StaticResource FortivaSecondaryButton}" Click="AddEntryFull_Click" Content="Full form…"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="EmptyCategoryState" Visibility="Collapsed"
                    Style="{StaticResource FortivaGlassPanelGlow}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="32,28" MaxWidth="420">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE8E7;" FontSize="36"
                              Foreground="{ThemeResource FortivaAccentBrush}" Opacity="0.85"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="No entries in this category" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource FortivaHeadingBrush}"/>
                    <TextBlock Text="Try another category or clear your search."
                               TextWrapping="WrapWholeWords" TextAlignment="Center"
                               Style="{StaticResource FortivaBodyText}"/>
                </StackPanel>
            </Border>
            </Grid>

            <Border x:Name="DetailPane" Grid.Column="1" Visibility="Collapsed"
                    Style="{StaticResource FortivaGlassPanel}" Padding="0"
                    VerticalAlignment="Stretch" MinWidth="340" MaxWidth="480">
                <Frame x:Name="DetailEditorFrame" Background="Transparent"/>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource FortivaGlassPanel}" Padding="14,16"
                    VerticalAlignment="Stretch">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Categories" Style="{StaticResource FortivaSectionTitle}"/>
                        <TextBlock Text="Filter by tag or quick groups"
                                   Style="{StaticResource FortivaMutedText}"/>
                    </StackPanel>
                    <ListView x:Name="CategoryList" Grid.Row="1"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              SelectionChanged="CategoryList_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource FortivaCategoryListItem}"/>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:VaultCategoryItem">
                                <Grid ColumnSpacing="10" Padding="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="14"
                                              Foreground="{ThemeResource FortivaAccentBrush}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Label}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Label}"
                                               Foreground="{ThemeResource FortivaBodyBrush}"/>
                                    <Border Grid.Column="2" Style="{StaticResource FortivaVaultStatChip}"
                                            Padding="8,2" MinWidth="28">
                                        <TextBlock Text="{x:Bind Count}" FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{ThemeResource FortivaMutedBrush}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button x:Name="NewCategoryBtn" Grid.Row="2" Click="NewCategory_Click"
                            Style="{StaticResource FortivaSecondaryButton}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12"/>
                            <TextBlock Text="New category"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Bulk actions -->
        <Border x:Name="BulkActionBar" Grid.Row="3" Visibility="Collapsed"
                AutomationProperties.Name="Bulk actions"
                Style="{StaticResource FortivaToolbar}" Padding="24,10"
                Background="{ThemeResource FortivaAccentGlowBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BulkCountText" Style="{StaticResource FortivaBodyText}"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource FortivaSecondaryButton}"
                        Click="BulkTag_Click" Content="Add tag"/>
                <Button Grid.Column="2" Style="{StaticResource FortivaSecondaryButton}"
                        Click="BulkDelete_Click" Content="Delete"/>
                <Button Grid.Column="3" Style="{StaticResource FortivaIconButton}"
                        ToolTipService.ToolTip="Clear selection" Click="BulkClear_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="12"/>
                </Button>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="4" Style="{StaticResource FortivaToolbar}" Padding="24,8"
                x:Name="StatusBar">
            <TextBlock x:Name="CountText" Style="{StaticResource FortivaMutedText}"/>
        </Border>
    </Grid>
</Page>
