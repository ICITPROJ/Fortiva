<Page
    x:Class="Fortiva.AppHost.Pages.VaultPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header toolbar -->
        <Border Style="{StaticResource FortivaToolbar}">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="My Vault" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="1"
                            PlaceholderText="Search entries…"
                            MinWidth="180" MaxWidth="300" Width="240" Margin="8,0"
                            QueryIcon="Find"
                            TextChanged="SearchBox_TextChanged"/>
            <Button Grid.Column="2" Margin="0,0,8,0"
                    ToolTipService.ToolTip="Open password generator" Click="GeneratePassword_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE9D5;" FontSize="14"/>
                    <TextBlock Text="Password generator"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource FortivaAccentButton}" Click="AddEntry_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    <TextBlock Text="Add entry"/>
                </StackPanel>
            </Button>
            </Grid>
        </Border>

        <!-- Read-only warning -->
        <InfoBar x:Name="ReadOnlyBar" Grid.Row="1"
                 Title="Read-only vault"
                 Message="A potential rollback was detected. The vault is open in read-only mode."
                 Severity="Warning" IsOpen="False" IsClosable="False">
            <InfoBar.ActionButton>
                <Button x:Name="EnableEditingBtn" Content="Enable editing" Click="EnableEditing_Click"/>
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Entry list — uses {Binding} directly against VaultEntryViewModel -->
        <ListView x:Name="EntryList" Grid.Row="2"
                  SelectionMode="Single"
                  SelectionChanged="EntryList_SelectionChanged">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="12,8"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Initial avatar -->
                        <Border Width="36" Height="36" CornerRadius="8"
                                Background="{ThemeResource AccentFillColorTertiaryBrush}">
                            <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Username}" FontSize="12" Opacity="0.6"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Copy password — Tag carries the whole VM so handler can access Password -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <Button Tag="{Binding}" Visibility="{Binding HasTotp, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTipService.ToolTip="Copy authenticator code"
                                    Background="Transparent" BorderThickness="0"
                                    Width="36" Height="36" Padding="0"
                                    Click="CopyOtp_Click">
                                <FontIcon Glyph="&#xE192;" FontSize="14"/>
                            </Button>
                            <Button Tag="{Binding}"
                                    ToolTipService.ToolTip="Copy password"
                                    Background="Transparent" BorderThickness="0"
                                    Width="36" Height="36" Padding="0"
                                    Click="CopyPassword_Click">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Status bar -->
        <Border Grid.Row="3" Padding="16,6"
                Background="{ThemeResource FortivaAcrylicBrush}"
                BorderBrush="{ThemeResource FortivaGlassBorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="CountText" FontSize="12" Opacity="0.6"/>
        </Border>
    </Grid>
</Page>
