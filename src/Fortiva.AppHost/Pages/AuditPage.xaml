<Page
    x:Class="Fortiva.AppHost.Pages.AuditPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource FortivaToolbar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Audit Log" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource FortivaSecondaryButton}" Click="Export_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEA53;" FontSize="14"/>
                        <TextBlock Text="Export for SIEM"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ListView x:Name="AuditList" Grid.Row="1" SelectionMode="None" Background="Transparent"/>

        <Border Grid.Row="2" Style="{StaticResource FortivaToolbar}" Padding="16,6">
            <TextBlock x:Name="CountLabel" Style="{StaticResource FortivaMutedText}"/>
        </Border>
    </Grid>
</Page>
