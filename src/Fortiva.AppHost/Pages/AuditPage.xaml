<Page
    x:Class="Fortiva.AppHost.Pages.AuditPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Padding="16,12" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Audit Log" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Click="Export_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xEA53;" FontSize="14"/>
                    <TextBlock Text="Export for SIEM"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ItemTemplate intentionally omitted — code-behind builds Grid rows directly -->
        <ListView x:Name="AuditList" Grid.Row="1" SelectionMode="None"/>

        <Border Grid.Row="2" Padding="16,6"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="CountLabel" FontSize="12" Opacity="0.6"/>
        </Border>
    </Grid>
</Page>
