<Page
    x:Class="Fortiva.AppHost.Pages.EntryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Margin="24" RowSpacing="16" MaxWidth="600" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Background="Transparent" BorderThickness="0" Click="Back_Click" Padding="4">
                <FontIcon Glyph="&#xE76B;" FontSize="16"/>
            </Button>
            <TextBlock x:Name="PageTitle" Grid.Column="1" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="8,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="DeleteBtn" Visibility="Collapsed" Click="Delete_Click"
                        Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE74D;" FontSize="16"
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                </Button>
                <ToggleButton x:Name="FavoriteBtn" Background="Transparent" BorderThickness="0">
                    <FontIcon x:Name="FavoriteIcon" Glyph="&#xE734;" FontSize="16"/>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- Form -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
                <!-- Title -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Title" FontWeight="SemiBold" FontSize="13"/>
                    <TextBox x:Name="TitleBox" PlaceholderText="e.g. GitHub, Work Email…"/>
                </StackPanel>

                <!-- Username -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Username / Email" FontWeight="SemiBold" FontSize="13"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="UsernameBox" PlaceholderText="username or email"/>
                        <Button Grid.Column="1" ToolTipService.ToolTip="Copy username" Click="CopyUsername_Click">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Password -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Password" FontWeight="SemiBold" FontSize="13"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PasswordBox" PlaceholderText="password" Grid.Column="0"
                                     PasswordRevealMode="Peek"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>
                        <Button Grid.Column="1" ToolTipService.ToolTip="Copy password" Click="CopyPassword_Click">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                        </Button>
                        <Button Grid.Column="2" ToolTipService.ToolTip="Reveal for 5 s" Click="RevealPassword_Click">
                            <FontIcon Glyph="&#xE7B3;" FontSize="14"/>
                        </Button>
                        <Button Grid.Column="3" ToolTipService.ToolTip="Generate password" Click="GeneratePassword_Click">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE9D5;" FontSize="14"/>
                                <TextBlock Text="Generate"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Password strength indicator -->
                    <ProgressBar x:Name="StrengthBar" Maximum="4" Value="0" Height="4"/>
                    <TextBlock x:Name="StrengthLabel" FontSize="11" Opacity="0.6"/>
                </StackPanel>

                <!-- URL -->
                <StackPanel Spacing="4">
                    <TextBlock Text="URL" FontWeight="SemiBold" FontSize="13"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="UrlBox" PlaceholderText="https://example.com"/>
                        <HyperlinkButton Grid.Column="1" x:Name="VisitLink" Content="Visit" Click="VisitUrl_Click"/>
                    </Grid>
                </StackPanel>

                <!-- Tags -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Tags (comma-separated)" FontWeight="SemiBold" FontSize="13"/>
                    <TextBox x:Name="TagsBox" PlaceholderText="work, personal, finance…"/>
                </StackPanel>

                <!-- Notes -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Notes" FontWeight="SemiBold" FontSize="13"/>
                    <TextBox x:Name="NotesBox" PlaceholderText="Optional notes…"
                             AcceptsReturn="True" Height="100" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Secure note toggle -->
                <ToggleSwitch x:Name="SecureNoteToggle" Header="This is a secure note (no password)"/>

                <!-- Authenticator / TOTP (Enterprise) -->
                <StackPanel x:Name="OtpSection" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Authenticator (TOTP)" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock TextWrapping="WrapWholeWords" Opacity="0.7" FontSize="12">
                        Paste the Base32 secret or otpauth:// URI from your identity provider setup.
                    </TextBlock>
                    <PasswordBox x:Name="TotpSecretBox" PlaceholderText="Base32 secret or otpauth:// URI"
                                 PasswordChanged="TotpSecret_Changed"/>
                    <Border CornerRadius="8" Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Current code" FontSize="12" Opacity="0.7"/>
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="OtpCodeText" FontSize="32" FontWeight="SemiBold"
                                           FontFamily="Consolas"/>
                            <ProgressBar x:Name="OtpTimerBar" Minimum="0" Maximum="30" Height="4"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OtpTimerLabel" Grid.Column="0" FontSize="11" Opacity="0.6"/>
                                <Button Grid.Column="1" Click="CopyOtp_Click"
                                        ToolTipService.ToolTip="Copy one-time code">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                                        <TextBlock Text="Copy code"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Click="Back_Click"/>
            <Button x:Name="SaveBtn" Content="Save" Style="{StaticResource FortivaAccentButton}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Page>
