<Page
    x:Class="Fortiva.AppHost.Pages.EntryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    SizeChanged="Page_SizeChanged">

    <Grid Margin="24,20,24,16" RowSpacing="12"
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackBtn" Style="{StaticResource FortivaIconButton}" Click="Back_Click">
                <FontIcon Glyph="&#xE76B;" FontSize="16"/>
            </Button>
            <TextBlock x:Name="PageTitle" Grid.Column="1" Style="{StaticResource FortivaPageTitle}"
                       FontSize="20" VerticalAlignment="Center" Margin="8,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="DeleteBtn" Visibility="Collapsed" Click="Delete_Click"
                        Style="{StaticResource FortivaIconButton}">
                    <FontIcon Glyph="&#xE74D;" FontSize="16"
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                </Button>
                <ToggleButton x:Name="FavoriteBtn" Style="{StaticResource FortivaIconToggleButton}">
                    <FontIcon x:Name="FavoriteIcon" Glyph="&#xE734;" FontSize="16"/>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- Form — stretches to full content width -->
        <ScrollViewer x:Name="FormScroll" Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Top">
            <Border Style="{StaticResource FortivaGlassPanel}"
                    HorizontalAlignment="Stretch"
                    MinWidth="320"
                    Width="{Binding ViewportWidth, ElementName=FormScroll}">
                <Grid x:Name="FormGrid" ColumnSpacing="24" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="FormCol0" Width="*" MinWidth="240"/>
                        <ColumnDefinition x:Name="FormCol1" Width="*" MinWidth="240"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <StackPanel x:Name="TitlePanel" Grid.ColumnSpan="2" Spacing="6">
                        <TextBlock Text="Title" Style="{StaticResource FortivaFieldLabel}"/>
                        <TextBox x:Name="TitleBox" Style="{StaticResource FortivaTextBox}"
                                 PlaceholderText="e.g. GitHub, Work Email…"/>
                    </StackPanel>

                    <!-- Username -->
                    <StackPanel x:Name="UsernamePanel" Grid.Row="1" Grid.Column="0" Spacing="6">
                        <TextBlock Text="Username / Email" Style="{StaticResource FortivaFieldLabel}"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="UsernameBox" Style="{StaticResource FortivaTextBox}"
                                     PlaceholderText="username or email"/>
                            <Button Grid.Column="1" ToolTipService.ToolTip="Copy username" Click="CopyUsername_Click"
                                    Style="{StaticResource FortivaIconButton}">
                                <FontIcon Glyph="&#xE779;" FontSize="14"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Website -->
                    <StackPanel x:Name="UrlPanel" Grid.Row="1" Grid.Column="1" Spacing="6">
                        <TextBlock Text="Website (browser Fill)" Style="{StaticResource FortivaFieldLabel}"/>
                        <TextBlock TextWrapping="WrapWholeWords" Style="{StaticResource FortivaHelperText}">
                            Login page URL so the Fortiva extension can match this entry. Example: https://login.example.com
                        </TextBlock>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="UrlBox" Style="{StaticResource FortivaTextBox}"
                                     PlaceholderText="https://login.example.com"/>
                            <HyperlinkButton Grid.Column="1" x:Name="VisitLink" Content="Visit"
                                             Style="{StaticResource FortivaHyperlink}" Click="VisitUrl_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel x:Name="PasswordPanel" Grid.Row="2" Grid.ColumnSpan="2" Spacing="8">
                        <TextBlock Text="Password" Style="{StaticResource FortivaFieldLabel}"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="PasswordBox" Style="{StaticResource FortivaPasswordBox}"
                                         PlaceholderText="password" Grid.Column="0"
                                         PasswordRevealMode="Peek"
                                         PasswordChanged="PasswordBox_PasswordChanged"/>
                            <Button Grid.Column="1" ToolTipService.ToolTip="Copy password" Click="CopyPassword_Click"
                                    Style="{StaticResource FortivaIconButton}">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                            </Button>
                            <Button Grid.Column="2" ToolTipService.ToolTip="Reveal for 5 s" Click="RevealPassword_Click"
                                    Style="{StaticResource FortivaIconButton}">
                                <FontIcon Glyph="&#xE7B3;" FontSize="14"/>
                            </Button>
                            <Button Grid.Column="3" ToolTipService.ToolTip="Generate password" Click="GeneratePassword_Click"
                                    Style="{StaticResource FortivaSecondaryButton}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE9D5;" FontSize="14"/>
                                    <TextBlock Text="Generate"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ProgressBar x:Name="StrengthBar" Maximum="4" Value="0" Height="4"/>
                        <TextBlock x:Name="StrengthLabel" Style="{StaticResource FortivaMutedText}"/>
                    </StackPanel>

                    <!-- Tags -->
                    <StackPanel x:Name="TagsPanel" Grid.Row="3" Grid.Column="0" Spacing="6">
                        <TextBlock Text="Categories" Style="{StaticResource FortivaFieldLabel}"/>
                        <Border x:Name="TagsPickerHost"/>
                    </StackPanel>

                    <!-- Secure note toggle -->
                    <StackPanel x:Name="SecureNotePanel" Grid.Row="3" Grid.Column="1" VerticalAlignment="Bottom" Padding="0,0,0,4">
                        <ToggleSwitch x:Name="SecureNoteToggle" Style="{StaticResource FortivaToggleSwitch}"
                                      Header="This is a secure note (no password)"
                                      Toggled="SecureNoteToggle_Toggled"/>
                    </StackPanel>

                    <!-- Notes -->
                    <StackPanel x:Name="NotesPanel" Grid.Row="4" Grid.ColumnSpan="2" Spacing="6">
                        <TextBlock Text="Notes" Style="{StaticResource FortivaFieldLabel}"/>
                        <TextBox x:Name="NotesBox" Style="{StaticResource FortivaTextBox}"
                                 PlaceholderText="Optional notes…"
                                 AcceptsReturn="True" MinHeight="100" MaxHeight="200" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Import provenance -->
                    <StackPanel x:Name="ProvenancePanel" Grid.Row="5" Grid.ColumnSpan="2" Spacing="6" Visibility="Collapsed">
                        <TextBlock Text="Import history" Style="{StaticResource FortivaFieldLabel}"/>
                        <TextBlock x:Name="ProvenanceSourceText" TextWrapping="WrapWholeWords" Style="{StaticResource FortivaBodyText}" FontSize="13"/>
                        <TextBlock x:Name="ProvenanceDatesText" TextWrapping="WrapWholeWords" Style="{StaticResource FortivaMutedText}" FontSize="12"/>
                    </StackPanel>

                    <!-- Authenticator / TOTP -->
                    <StackPanel x:Name="OtpSection" Grid.Row="6" Grid.ColumnSpan="2" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Authenticator (TOTP)" Style="{StaticResource FortivaFieldLabel}"/>
                        <TextBlock TextWrapping="WrapWholeWords" Style="{StaticResource FortivaMutedText}">
                            Paste the Base32 secret or otpauth:// URI from your identity provider setup.
                        </TextBlock>
                        <Grid x:Name="OtpGrid" ColumnSpacing="24" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="OtpCol0" Width="*" MinWidth="240"/>
                                <ColumnDefinition x:Name="OtpCol1" Width="*" MinWidth="240"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <PasswordBox x:Name="TotpSecretBox" Style="{StaticResource FortivaPasswordBox}"
                                         MinHeight="48" FontSize="14"
                                         PlaceholderText="Base32 secret or otpauth:// URI"
                                         PasswordChanged="TotpSecret_Changed"/>
                            <Border x:Name="OtpPreviewBorder" Grid.Column="1" Style="{StaticResource FortivaMonoPreview}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Current code" Style="{StaticResource FortivaMutedText}"/>
                                    <TextBlock x:Name="OtpCodeText" FontSize="32" FontWeight="SemiBold"
                                               FontFamily="Consolas"/>
                                    <ProgressBar x:Name="OtpTimerBar" Minimum="0" Maximum="30" Height="4"/>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="OtpTimerLabel" Grid.Column="0" Style="{StaticResource FortivaMutedText}"/>
                                        <Button Grid.Column="1" Click="CopyOtp_Click"
                                                ToolTipService.ToolTip="Copy one-time code">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                                                <TextBlock Text="Copy code"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>

        <!-- Footer actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Click="Back_Click" Style="{StaticResource FortivaSecondaryButton}"/>
            <Button x:Name="SaveBtn" Content="Save" Style="{StaticResource FortivaAccentButton}"
                    ToolTipService.ToolTip="Save entry (Ctrl+S)" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Page>
