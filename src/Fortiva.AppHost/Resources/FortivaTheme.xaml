<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <LinearGradientBrush x:Key="FortivaAmbientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#f0f6ff" Offset="0"/>
                <GradientStop Color="#dce8ff" Offset="0.45"/>
                <GradientStop Color="#eef2ff" Offset="1"/>
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="FortivaGlowOrbBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#6000A4FF" Offset="0"/>
                <GradientStop Color="#0000A4FF" Offset="1"/>
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="FortivaGlowOrbSecondaryBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#40007AFF" Offset="0"/>
                <GradientStop Color="#00007AFF" Offset="1"/>
            </RadialGradientBrush>
            <SolidColorBrush x:Key="FortivaGlassFillBrush" Color="#B8FFFFFF"/>
            <SolidColorBrush x:Key="FortivaGlassBorderBrush" Color="#660078D4"/>
            <SolidColorBrush x:Key="FortivaAccentGlowBrush" Color="#3300A4FF"/>
            <SolidColorBrush x:Key="FortivaTitleBarBrush" Color="#CCF4F8FF"/>
            <SolidColorBrush x:Key="FortivaNavPaneBrush" Color="#E8F0F8FF"/>
            <SolidColorBrush x:Key="FortivaAcrylicBrush" Color="#CCE8F2FF"/>
            <SolidColorBrush x:Key="FortivaAcrylicNavBrush" Color="#DDF0F8FF"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <LinearGradientBrush x:Key="FortivaAmbientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#04060c" Offset="0"/>
                <GradientStop Color="#0c1424" Offset="0.4"/>
                <GradientStop Color="#080e18" Offset="1"/>
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="FortivaGlowOrbBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#7000E5FF" Offset="0"/>
                <GradientStop Color="#0000E5FF" Offset="1"/>
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="FortivaGlowOrbSecondaryBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#500060FF" Offset="0"/>
                <GradientStop Color="#000060FF" Offset="1"/>
            </RadialGradientBrush>
            <SolidColorBrush x:Key="FortivaGlassFillBrush" Color="#28FFFFFF"/>
            <SolidColorBrush x:Key="FortivaGlassBorderBrush" Color="#6600D4FF"/>
            <SolidColorBrush x:Key="FortivaAccentGlowBrush" Color="#4000E5FF"/>
            <SolidColorBrush x:Key="FortivaTitleBarBrush" Color="#55081018"/>
            <SolidColorBrush x:Key="FortivaNavPaneBrush" Color="#44081018"/>
            <SolidColorBrush x:Key="FortivaAcrylicBrush" Color="#44101828"/>
            <SolidColorBrush x:Key="FortivaAcrylicNavBrush" Color="#55081018"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="FortivaGlassPanel" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FortivaAcrylicBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource FortivaGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <Style x:Key="FortivaGlassPanelGlow" TargetType="Border" BasedOn="{StaticResource FortivaGlassPanel}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1800D4FF" Offset="0"/>
                    <GradientStop Color="#0800D4FF" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FortivaAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="FortivaSecondaryButton" TargetType="Button">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Background" Value="{ThemeResource FortivaGlassFillBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource FortivaGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="FortivaHeroTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="FortivaPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="FortivaSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Opacity" Value="0.75"/>
    </Style>

    <Style x:Key="FortivaToolbar" TargetType="Border">
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Background" Value="{ThemeResource FortivaAcrylicBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource FortivaGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

</ResourceDictionary>
