<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand palette (matches fortiva website): bg #0a0c10, accent #40BCF4, heading #FFFFFF, body #A0AAB2 -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="FortivaBackgroundColor">#D8E4F0</Color>
            <Color x:Key="FortivaHeadingColor">#0A0C10</Color>
            <Color x:Key="FortivaBodyColor">#3D4A56</Color>
            <Color x:Key="FortivaMutedColor">#5C6A78</Color>
            <Color x:Key="FortivaAccentColor">#2AA8E0</Color>
            <Color x:Key="FortivaAccentButtonFgColor">#FFFFFF</Color>

            <LinearGradientBrush x:Key="FortivaAmbientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#EAF2FA" Offset="0"/>
                <GradientStop Color="#C8DCEE" Offset="0.42"/>
                <GradientStop Color="#D4E8F6" Offset="0.72"/>
                <GradientStop Color="#E2EFF8" Offset="1"/>
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="FortivaGlowOrbBrush" GradientOrigin="0.5,0.35" Center="0.5,0.35" RadiusX="0.6" RadiusY="0.6">
                <GradientStop Color="#9040BCF4" Offset="0"/>
                <GradientStop Color="#2040BCF4" Offset="0.55"/>
                <GradientStop Color="#0040BCF4" Offset="1"/>
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="FortivaGlowOrbSecondaryBrush" GradientOrigin="0.15,0.85" Center="0.15,0.85" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#7040BCF4" Offset="0"/>
                <GradientStop Color="#0040BCF4" Offset="1"/>
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="FortivaGlowPanelGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#CCFFFFFF" Offset="0"/>
                <GradientStop Color="#99E8F4FC" Offset="0.45"/>
                <GradientStop Color="#6640BCF4" Offset="1"/>
            </LinearGradientBrush>

            <SolidColorBrush x:Key="FortivaBackgroundBrush" Color="{StaticResource FortivaBackgroundColor}"/>
            <SolidColorBrush x:Key="FortivaHeadingBrush" Color="{StaticResource FortivaHeadingColor}"/>
            <SolidColorBrush x:Key="FortivaBodyBrush" Color="{StaticResource FortivaBodyColor}"/>
            <SolidColorBrush x:Key="FortivaMutedBrush" Color="{StaticResource FortivaMutedColor}"/>
            <SolidColorBrush x:Key="FortivaAccentBrush" Color="{StaticResource FortivaAccentColor}"/>
            <SolidColorBrush x:Key="FortivaAccentIconBrush" Color="{StaticResource FortivaAccentColor}"/>
            <SolidColorBrush x:Key="FortivaAccentButtonForegroundBrush" Color="{StaticResource FortivaAccentButtonFgColor}"/>
            <!-- Frosted glass surfaces -->
            <SolidColorBrush x:Key="FortivaGlassFillBrush" Color="#EBFFFFFF"/>
            <SolidColorBrush x:Key="FortivaSurfaceBrush" Color="#F5FAFE"/>
            <SolidColorBrush x:Key="FortivaSurfaceSubtleBrush" Color="#E8F4FA"/>
            <SolidColorBrush x:Key="FortivaInputFillBrush" Color="#F8FCFF"/>
            <SolidColorBrush x:Key="FortivaInputBorderBrush" Color="#8EB4CC"/>
            <SolidColorBrush x:Key="FortivaGlassBorderBrush" Color="#8040BCF4"/>
            <SolidColorBrush x:Key="FortivaAccentGlowBrush" Color="#2840BCF4"/>
            <SolidColorBrush x:Key="FortivaTitleBarBrush" Color="#CCFFFFFF"/>
            <SolidColorBrush x:Key="FortivaNavPaneBrush" Color="#D6ECF8"/>
            <SolidColorBrush x:Key="FortivaAcrylicBrush" Color="#D0E8F6"/>
            <SolidColorBrush x:Key="FortivaAcrylicNavBrush" Color="#CAE4F4"/>

            <SolidColorBrush x:Key="FortivaStatusSuccessBrush" Color="#3310A05A"/>
            <SolidColorBrush x:Key="FortivaStatusWarningBrush" Color="#33C88200"/>
            <SolidColorBrush x:Key="FortivaStatusErrorBrush" Color="#33DC3232"/>

            <!-- WinUI system control tokens (light frosted glass) -->
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#E6F4FC"/>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#D8ECF8"/>
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#C8E2F0"/>
            <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#6688959E"/>
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#8EB4CC"/>
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#6640BCF4"/>
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#0A0C10"/>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#3D4A56"/>
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5C6A78"/>
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#6640BCF4"/>

            <SolidColorBrush x:Key="ComboBoxBackground" Color="#F8FCFF"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#EAF6FC"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#DCEEF8"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#6688959E"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#8EB4CC"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#6640BCF4"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#8840BCF4"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#4488959E"/>
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#0A0C10"/>
            <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#5C6A78"/>
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#0A0C10"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#F8FCFF"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#8840BCF4"/>
            <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#0A0C10"/>
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#F5FAFE"/>
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#8EB4CC"/>

            <SolidColorBrush x:Key="TextControlBackground" Color="#F8FCFF"/>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#EAF6FC"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#6688959E"/>
            <SolidColorBrush x:Key="TextControlForeground" Color="#0A0C10"/>
            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#5C6A78"/>
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#8EB4CC"/>
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#6640BCF4"/>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#8840BCF4"/>
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#4488959E"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#5C6A78"/>

            <SolidColorBrush x:Key="ContentDialogBackground" Color="#F0F8FD"/>
            <SolidColorBrush x:Key="ContentDialogForeground" Color="#0A0C10"/>
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#8040BCF4"/>
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#00000000"/>
            <SolidColorBrush x:Key="ContentDialogSeparator" Color="#6640BCF4"/>

            <SolidColorBrush x:Key="ButtonBackground" Color="#E6F4FC"/>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#D8ECF8"/>
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#C8E2F0"/>
            <SolidColorBrush x:Key="ButtonForeground" Color="#0A0C10"/>
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#8EB4CC"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#6640BCF4"/>

            <LinearGradientBrush x:Key="FortivaPreviewGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#EEFFFFFF" Offset="0"/>
                <GradientStop Color="#CCE8F6FC" Offset="0.5"/>
                <GradientStop Color="#9940BCF4" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#5CC8F6"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#B8CEDC"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#A8C4D8"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#40BCF4"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#88A8C0"/>

            <SolidColorBrush x:Key="SliderTrackFill" Color="#C8DCE8"/>
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#B0D0E4"/>
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#A0C8E0"/>
            <SolidColorBrush x:Key="SliderThumbFill" Color="#40BCF4"/>

            <!-- WinUI accent overrides -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource FortivaAccentColor}"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#6640BCF4"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#3340BCF4"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#CAE4F4"/>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#CAE4F4"/>
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#CAE4F4"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="FortivaBackgroundColor">#0A0C10</Color>
            <Color x:Key="FortivaHeadingColor">#FFFFFF</Color>
            <Color x:Key="FortivaBodyColor">#A0AAB2</Color>
            <Color x:Key="FortivaMutedColor">#6B7580</Color>
            <Color x:Key="FortivaAccentColor">#40BCF4</Color>
            <Color x:Key="FortivaAccentButtonFgColor">#0A0C10</Color>

            <LinearGradientBrush x:Key="FortivaAmbientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A0C10" Offset="0"/>
                <GradientStop Color="#0D1118" Offset="0.45"/>
                <GradientStop Color="#0A0C10" Offset="1"/>
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="FortivaGlowOrbBrush" GradientOrigin="0.5,0.3" Center="0.5,0.3" RadiusX="0.6" RadiusY="0.6">
                <GradientStop Color="#5040BCF4" Offset="0"/>
                <GradientStop Color="#0040BCF4" Offset="1"/>
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="FortivaGlowOrbSecondaryBrush" GradientOrigin="0.85,0.85" Center="0.85,0.85" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#3540BCF4" Offset="0"/>
                <GradientStop Color="#0040BCF4" Offset="1"/>
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="FortivaGlowPanelGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2840BCF4" Offset="0"/>
                <GradientStop Color="#0C40BCF4" Offset="1"/>
            </LinearGradientBrush>

            <SolidColorBrush x:Key="FortivaBackgroundBrush" Color="{StaticResource FortivaBackgroundColor}"/>
            <SolidColorBrush x:Key="FortivaHeadingBrush" Color="{StaticResource FortivaHeadingColor}"/>
            <SolidColorBrush x:Key="FortivaBodyBrush" Color="{StaticResource FortivaBodyColor}"/>
            <SolidColorBrush x:Key="FortivaMutedBrush" Color="{StaticResource FortivaMutedColor}"/>
            <SolidColorBrush x:Key="FortivaAccentBrush" Color="{StaticResource FortivaAccentColor}"/>
            <SolidColorBrush x:Key="FortivaAccentIconBrush" Color="{StaticResource FortivaAccentColor}"/>
            <SolidColorBrush x:Key="FortivaAccentButtonForegroundBrush" Color="{StaticResource FortivaAccentButtonFgColor}"/>
            <SolidColorBrush x:Key="FortivaSurfaceBrush" Color="#161B22"/>
            <SolidColorBrush x:Key="FortivaSurfaceSubtleBrush" Color="#12161C"/>
            <SolidColorBrush x:Key="FortivaInputFillBrush" Color="#0E1218"/>
            <SolidColorBrush x:Key="FortivaInputBorderBrush" Color="#2A3440"/>
            <SolidColorBrush x:Key="FortivaGlassFillBrush" Color="#80161822"/>
            <SolidColorBrush x:Key="FortivaGlassBorderBrush" Color="#6640BCF4"/>
            <SolidColorBrush x:Key="FortivaAccentGlowBrush" Color="#3340BCF4"/>
            <SolidColorBrush x:Key="FortivaTitleBarBrush" Color="#990A0C10"/>
            <LinearGradientBrush x:Key="FortivaPreviewGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#50161822" Offset="0"/>
                <GradientStop Color="#3340BCF4" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="FortivaNavPaneBrush" Color="#66101820"/>
            <SolidColorBrush x:Key="FortivaAcrylicBrush" Color="#66101820"/>
            <SolidColorBrush x:Key="FortivaAcrylicNavBrush" Color="#77101820"/>

            <SolidColorBrush x:Key="FortivaStatusSuccessBrush" Color="#3300B450"/>
            <SolidColorBrush x:Key="FortivaStatusWarningBrush" Color="#33C85000"/>
            <SolidColorBrush x:Key="FortivaStatusErrorBrush" Color="#33C83232"/>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource FortivaAccentColor}"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#6640BCF4"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#3340BCF4"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource FortivaAccentButtonFgColor}"/>
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource FortivaAccentButtonFgColor}"/>
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#77101820"/>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#77101820"/>
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#77101820"/>

            <SolidColorBrush x:Key="ContentDialogBackground" Color="#161B22"/>
            <SolidColorBrush x:Key="ContentDialogForeground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#6640BCF4"/>
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#00000000"/>
            <SolidColorBrush x:Key="ContentDialogSeparator" Color="#6640BCF4"/>

            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#5CC8F6"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#2A3440"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#354050"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#0A0C10"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#40BCF4"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#4A5564"/>

            <SolidColorBrush x:Key="SliderTrackFill" Color="#2A3440"/>
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#354050"/>
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#404C5C"/>
            <SolidColorBrush x:Key="SliderThumbFill" Color="#40BCF4"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <ThemeShadow x:Key="FortivaCardShadow"/>
    <ThemeShadow x:Key="FortivaDialogShadow"/>

    <Style x:Key="FortivaGlassPanel" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FortivaGlassFillBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource FortivaGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Shadow" Value="{StaticResource FortivaCardShadow}"/>
    </Style>

    <Style x:Key="FortivaGlassPanelGlow" TargetType="Border" BasedOn="{StaticResource FortivaGlassPanel}">
        <Setter Property="Background" Value="{ThemeResource FortivaGlowPanelGradientBrush}"/>
    </Style>

    <Style x:Key="FortivaSectionDivider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{ThemeResource FortivaGlassBorderBrush}"/>
        <Setter Property="Opacity" Value="0.55"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>

    <Style x:Key="FortivaStatusPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Background" Value="{ThemeResource FortivaAccentGlowBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource FortivaGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="FortivaAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource FortivaAccentBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource FortivaAccentButtonForegroundBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
    </Style>

    <Style x:Key="FortivaSecondaryButton" TargetType="Button">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Background" Value="{ThemeResource FortivaGlassFillBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource FortivaHeadingBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource FortivaGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
    </Style>

    <Style x:Key="FortivaIconButton" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{ThemeResource FortivaMutedBrush}"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
    </Style>

    <Style x:Key="FortivaNavigationViewItem" TargetType="NavigationViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="6,2"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="FortivaCategoryListItem" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Margin" Value="0,1"/>
    </Style>

    <Style x:Key="FortivaVaultGridItem" TargetType="GridViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,0,14,14"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinWidth" Value="320"/>
        <Setter Property="MaxWidth" Value="520"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style x:Key="FortivaSearchBox" TargetType="AutoSuggestBox">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{ThemeResource FortivaInputFillBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource FortivaInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="FortivaFieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource FortivaHeadingBrush}"/>
    </Style>

    <Style x:Key="FortivaTextBox" TargetType="TextBox">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{ThemeResource FortivaInputFillBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource FortivaInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{ThemeResource FortivaHeadingBrush}"/>
    </Style>

    <Style x:Key="FortivaPasswordBox" TargetType="PasswordBox">
        <Setter Property="MinHeight" Value="52"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{ThemeResource FortivaInputFillBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource FortivaInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{ThemeResource FortivaHeadingBrush}"/>
    </Style>

    <Style x:Key="FortivaComboBox" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{ThemeResource FortivaInputFillBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource FortivaInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{ThemeResource FortivaHeadingBrush}"/>
    </Style>

    <Style x:Key="FortivaToggleSwitch" TargetType="ToggleSwitch">
        <Setter Property="Foreground" Value="{ThemeResource FortivaBodyBrush}"/>
    </Style>

    <Style x:Key="FortivaSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{ThemeResource FortivaAccentBrush}"/>
    </Style>

    <Style x:Key="FortivaMonoPreview" TargetType="Border">
        <Setter Property="MinHeight" Value="72"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{ThemeResource FortivaPreviewGradientBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource FortivaGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Shadow" Value="{StaticResource FortivaCardShadow}"/>
    </Style>

    <Style x:Key="FortivaHeroTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource FortivaHeadingBrush}"/>
    </Style>

    <Style x:Key="FortivaPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource FortivaHeadingBrush}"/>
    </Style>

    <Style x:Key="FortivaSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource FortivaHeadingBrush}"/>
    </Style>

    <Style x:Key="FortivaHelperText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{ThemeResource FortivaMutedBrush}"/>
        <Setter Property="TextWrapping" Value="WrapWholeWords"/>
    </Style>

    <Style x:Key="FortivaBodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{ThemeResource FortivaBodyBrush}"/>
        <Setter Property="TextWrapping" Value="WrapWholeWords"/>
    </Style>

    <Style x:Key="FortivaMutedText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource FortivaMutedBrush}"/>
        <Setter Property="TextWrapping" Value="WrapWholeWords"/>
    </Style>

    <Style x:Key="FortivaVaultCard" TargetType="Border" BasedOn="{StaticResource FortivaGlassPanel}">
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="MinHeight" Value="92"/>
    </Style>

    <Style x:Key="FortivaVaultStatChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Background" Value="{ThemeResource FortivaAccentGlowBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource FortivaGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="FortivaTagChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Background" Value="{ThemeResource FortivaAccentGlowBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource FortivaGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="FortivaToolbar" TargetType="Border">
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Background" Value="{ThemeResource FortivaAcrylicBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource FortivaGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="FortivaHyperlink" TargetType="HyperlinkButton">
        <Setter Property="Foreground" Value="{ThemeResource FortivaAccentBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="FortivaAdminTabContent" TargetType="StackPanel">
        <Setter Property="Margin" Value="24"/>
        <Setter Property="Spacing" Value="20"/>
        <Setter Property="MaxWidth" Value="680"/>
    </Style>

</ResourceDictionary>
