<Page
    x:Class="Fortiva.AppHost.Admin.AdminMainWindow"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <TabView x:Name="MainTabView" IsAddTabButtonVisible="False" VerticalAlignment="Stretch">
            <!-- ── License ─────────────────────────────────────────────── -->
            <TabViewItem Header="License">
                <ScrollViewer>
                    <StackPanel Margin="24" Spacing="20" MaxWidth="640">
                        <TextBlock Text="License Management" FontSize="22" FontWeight="SemiBold"/>

                        <Border x:Name="LicenseStatusBanner" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon x:Name="LicenseIcon" Glyph="&#xE8D7;" FontSize="24"/>
                                    <TextBlock x:Name="LicenseStatus" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="LicenseDetail" FontSize="13" Opacity="0.7" FontFamily="Consolas"
                                           TextWrapping="WrapWholeWords"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="8">
                            <Button Click="ImportLicense_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B5;" FontSize="14"/>
                                    <TextBlock Text="Import license file…"/>
                                </StackPanel>
                            </Button>
                            <Button Content="Verify current license" Click="VerifyLicense_Click"/>
                            <Button x:Name="GenerateTrialBtn" Content="Generate trial (dev only)" Click="GenerateTrial_Click" Opacity="0.7"/>
                        </StackPanel>

                        <InfoBar x:Name="LicenseInfoBar" IsOpen="False" IsClosable="True"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ── Policy Editor ────────────────────────────────────────── -->
            <TabViewItem Header="Policy">
                <ScrollViewer>
                    <StackPanel Margin="24" Spacing="20" MaxWidth="640">
                        <TextBlock Text="Enterprise Policy" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="WrapWholeWords" Opacity="0.7" FontSize="13">
                            Policy settings are encrypted with DPAPI-LocalMachine and deployed to
                            %PROGRAMDATA%\Fortiva\. Users cannot override these settings.
                        </TextBlock>

                        <!-- KDF section -->
                        <Expander Header="Key Derivation (Argon2id)" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12" Padding="0,8,0,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Minimum memory (MB)" FontWeight="SemiBold" FontSize="13"/>
                                    <Slider x:Name="ArgonMemSlider" ValueChanged="ArgonMem_Changed"/>
                                    <TextBlock x:Name="ArgonMemLabel" FontSize="11" Opacity="0.6"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Minimum iterations" FontWeight="SemiBold" FontSize="13"/>
                                    <Slider x:Name="ArgonIterSlider" ValueChanged="ArgonIter_Changed"/>
                                    <TextBlock x:Name="ArgonIterLabel" FontSize="11" Opacity="0.6"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <!-- Lock/clipboard -->
                        <Expander Header="Lock &amp; Clipboard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12" Padding="0,8,0,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Maximum auto-lock (seconds)" FontWeight="SemiBold" FontSize="13"/>
                                    <Slider x:Name="AutoLockSlider" ValueChanged="AutoLock_Changed"/>
                                    <TextBlock x:Name="AutoLockLabel" FontSize="11" Opacity="0.6"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ClipboardDisabledSwitch" Header="Disable clipboard entirely"/>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Clipboard clear delay (seconds)" FontWeight="SemiBold" FontSize="13"/>
                                    <Slider x:Name="ClipboardSlider" ValueChanged="Clipboard_Changed"/>
                                    <TextBlock x:Name="ClipboardLabel" FontSize="11" Opacity="0.6"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <!-- Security toggles -->
                        <Expander Header="Security Requirements" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12" Padding="0,8,0,0">
                                <ToggleSwitch x:Name="ParanoiaSwitch" Header="Require Paranoia Mode"/>
                                <ToggleSwitch x:Name="HelloSwitch" Header="Require Windows Hello"/>
                                <ToggleSwitch x:Name="PortableSwitch" Header="Allow portable mode" IsOn="True"/>
                                <ToggleSwitch x:Name="TotpSwitch" Header="Allow authenticator (TOTP) codes"/>
                                <ComboBox x:Name="ExportModeBox" Header="Export policy" Width="220">
                                    <ComboBoxItem>Encrypted only</ComboBoxItem>
                                    <ComboBoxItem>No plaintext export</ComboBoxItem>
                                    <ComboBoxItem>Plaintext with warning</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </Expander>

                        <InfoBar x:Name="PolicyValidationBar" IsOpen="False" IsClosable="True"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{ThemeResource AccentButtonStyle}" Content="Save and deploy policy"
                                    Click="SavePolicy_Click"/>
                            <Button Content="Validate" Click="ValidatePolicy_Click"/>
                            <Button Content="Reset to defaults" Click="ResetPolicy_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ── Shared Vaults ────────────────────────────────────────── -->
            <TabViewItem Header="Shared Vaults">
                <StackPanel Margin="24" Spacing="16">
                    <TextBlock Text="Shared Vault Configuration" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="WrapWholeWords" Opacity="0.7" FontSize="13">
                        Configure shared vault paths for the Enterprise client.
                        Users can switch to these vaults in Fortiva Enterprise Settings.
                    </TextBlock>
                    <ListView x:Name="SharedVaultList" Height="200" SelectionMode="Single"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Add shared vault…" Click="AddSharedVault_Click"/>
                        <Button Content="Remove selected" Click="RemoveSharedVault_Click"/>
                    </StackPanel>
                </StackPanel>
            </TabViewItem>

            <!-- ── Audit ────────────────────────────────────────────────── -->
            <TabViewItem Header="Audit">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Padding="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Audit Log" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Export JSONL" Click="ExportAudit_Click"/>
                    </Grid>
                    <ListView x:Name="AuditList" Grid.Row="1" SelectionMode="None"/>
                    <TextBlock x:Name="AuditCount" Grid.Row="2" Margin="16,6" FontSize="12" Opacity="0.6"/>
                </Grid>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
