<Project>
  <PropertyGroup>
    <!-- Company / product identity â€” applied to every assembly in the solution -->
    <Company>icmclab studio</Company>
    <Authors>icmclab studio</Authors>
    <Product>Fortiva</Product>
    <Copyright>Copyright Â© icmclab studio 2026</Copyright>
    <PackageProjectUrl>https://fortiva.studio.icmclab.cloud/</PackageProjectUrl>
    <Version>1.0.50</Version>
    <AssemblyVersion>1.0.50.0</AssemblyVersion>
    <FileVersion>1.0.50.0</FileVersion>
  </PropertyGroup>
  <PropertyGroup>
    <WindowsAppSDKVersion>1.6.250108002</WindowsAppSDKVersion>
    <WindowsTargetPlatformMinVersion>10.0.19041.0</WindowsTargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GeneratePriFiles>false</GeneratePriFiles>
    <GenerateProjectPriFile>false</GenerateProjectPriFile>
    <MrtCoreEnablePriGeneration>false</MrtCoreEnablePriGeneration>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <AppxGeneratePrisForPortableLibrariesEnabled>false</AppxGeneratePrisForPortableLibrariesEnabled>
    <EnableMrtResourceIndexer>false</EnableMrtResourceIndexer>
    <!-- Disable all MSIX packaging targets â€” not needed for unpackaged/dev builds without VS -->
    <MsixPackageSupport>false</MsixPackageSupport>
    <ShouldImportMsixPackagingTargets>false</ShouldImportMsixPackagingTargets>
    <ShouldImportMsixCsTargets>false</ShouldImportMsixCsTargets>
    <ShouldImportMsixCppTargets>false</ShouldImportMsixCppTargets>
    <ShouldImportMsixDesignTimeTargets>false</ShouldImportMsixDesignTimeTargets>
  </PropertyGroup>
</Project>