{
  "manifest_version": 3,
  "name": "Fortiva Autofill",
  "version": "1.0.8",
  "description": "Manual fill only — Fortiva never autofills on page load or when you focus a password field.",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fortiva",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
