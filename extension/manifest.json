{
  "manifest_version": 3,
  "name": "Fortiva Autofill",
  "version": "1.0.49",
  "description": "Fill logins from your Fortiva vault when you click — handles multi-step sign-in flows.",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "http://127.0.0.1:7847/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "fill-coordinator.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fortiva — Fill",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
