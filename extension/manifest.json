{
  "manifest_version": 3,
  "name": "Fortiva Autofill",
  "version": "1.0.0",
  "description": "Local-only credential bridge to Fortiva. No cloud, no remote API.",
  "key": "",
  "permissions": ["activeTab", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fortiva"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
